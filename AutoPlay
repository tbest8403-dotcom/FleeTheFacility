--------------------------------------------------
-- COLOR MATCH
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(
		A.R - B.R
	) <= Tolerance
		and math.abs(
			A.G - B.G
		) <= Tolerance
		and math.abs(
			A.B - B.B
		) <= Tolerance
end

--------------------------------------------------
-- COMPUTER DONE
--------------------------------------------------

function AutoPlay:IsComputerDone(
	Computer
)
	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	return ColorsMatch(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

--------------------------------------------------
-- COMPUTER ERROR COLOR
--------------------------------------------------

function AutoPlay:IsComputerError(
	Computer
)
	if not Computer
		or self:IsComputerDone(
			Computer
		)
	then
		return false
	end

	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	local Color =
		Screen.Color

	local Red =
		Color.R

	local Green =
		Color.G

	local Blue =
		Color.B

	if Red
		< self.Config.ErrorMinimumRed
	then
		return false
	end

	local Dominance =
		Red
		- math.max(
			Green,
			Blue
		)

	return Dominance
		>= self.Config.ErrorRedDominance
end

--------------------------------------------------
-- WAIT FOR ERROR COLOR TO CLEAR
--------------------------------------------------

function AutoPlay:WaitForComputerErrorClear(
	Computer,
	Token
)
	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:IsComputerError(
			Computer
		)
		and os.clock()
			- Started
			< self.Config.ErrorColorWaitTimeout
	do
		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return true
end

--------------------------------------------------
-- LEAVE TRIGGER
--------------------------------------------------

function AutoPlay:LeaveTrigger()
	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				false
			)
		end
	)

	local Trigger =
		self._currentTrigger

	if Trigger
		and Trigger.Parent
	then
		local Event =
			Trigger:FindFirstChild(
				"Event"
			)

		if Event then
			pcall(
				function()
					RemoteEvent:FireServer(
						"Input",
						"Trigger",
						false,
						Event
					)
				end
			)
		end
	end

	self._currentTrigger =
		nil

	self._lastSkillGoal =
		nil
end

--------------------------------------------------
-- WAIT FOR ONTRIGGER
--------------------------------------------------

function AutoPlay:WaitForTriggerConfirmation(
	Token
)
	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.TriggerConfirmTimeout
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false
		end

		local OnTrigger =
			self:GetStatValue(
				"OnTrigger"
			)

		if OnTrigger == true then
			return true
		end

		--------------------------------------------------
		-- SOME VERSIONS DON'T EXPOSE ONTRIGGER
		--------------------------------------------------

		if OnTrigger == nil
			and os.clock()
				- Started
				>= self.Config.TriggerSettleTime
		then
			return true
		end

		task.wait(
			0.025
		)
	end

	return true
end

--------------------------------------------------
-- ENTER TRIGGER
--------------------------------------------------

function AutoPlay:EnterTrigger(
	Trigger,
	Token
)
	if not Trigger
		or not Trigger.Parent
	then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	if self._currentTrigger
		and self._currentTrigger
			~= Trigger
	then
		self:LeaveTrigger()
	end

	self._currentTrigger =
		Trigger

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Trigger",
				true,
				Event
			)
		end
	)

	self:WaitForTriggerConfirmation(
		Token
	)

	task.wait(
		self.Config.TriggerSettleTime
	)

	return true
end

--------------------------------------------------
-- START ACTION
--------------------------------------------------

function AutoPlay:StartAction(
	Trigger,
	Token
)
	if not self:EnterTrigger(
		Trigger,
		Token
	)
	then
		return false
	end

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				true
			)
		end
	)

	--------------------------------------------------
	-- MATCH CLIENT ACTION BEHAVIOR
	--------------------------------------------------

	self:SetStatValue(
		"ActionInput",
		true
	)

	task.wait(
		self.Config.ActionSettleTime
	)

	return true
end

--------------------------------------------------
-- PULSE ACTION
--------------------------------------------------

function AutoPlay:PulseAction(
	Trigger,
	Token,
	HoldTime
)
	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false
	end

	task.wait(
		HoldTime
			or 0.14
	)

	self:LeaveTrigger()

	return true
end

