--------------------------------------------------
-- STOP
--------------------------------------------------

function AutoPlay:Stop()
	self.Config.Enabled =
		false

	self._runToken += 1

	self:CancelMove()

	self:LeaveTrigger()

	self:_SetStatus(
		"Stopped"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)
end

function AutoPlay:Destroy()
	self:Stop()
end

return AutoPlay
