	Section:AddToggle({
		Name =
			"Auto Play",

		Default =
			false,

		Callback =
			function(
				Value
			)
				self:SetEnabled(
					Value
				)
			end,
	})

	Section:AddSlider({
		Name =
			"Beast Distance",

		Min =
			5,

		Max =
			50,

		Default =
			15,

		Increment =
			1,

		Callback =
			function(
				Value
			)
				self.Config.BeastAvoidDistance =
					Value

				self.Config.BeastResumeDistance =
					Value + 7
			end,
	})

	Section:AddSlider({
		Name =
			"Hide Depth",

		Min =
			8,

		Max =
			35,

		Default =
			self.Config.HideDepth,

		Increment =
			1,

		Callback =
			function(
				Value
			)
				self.Config.HideDepth =
					Value
			end,
	})
end

--------------------------------------------------
-- STOP
--------------------------------------------------

function AutoPlay:Stop()
	self:SetEnabled(
		false
	)
end

--------------------------------------------------
-- DESTROY
--------------------------------------------------

function AutoPlay:Destroy()
	self:Stop()

	table.clear(
		self._unreachableComputers
	)

	print(
		("[FleeTheFacility] %s %s destroyed"):format(
			self.Name,
			self.Version
		)
	)
end

return AutoPlay
