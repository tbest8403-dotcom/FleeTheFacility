-- OPEN DOOR
--------------------------------------------------

function AutoPlay:OpenDoor(
	Door,
	Trigger,
	Token
)
	if not Door
		or not Trigger
	then
		return false
	end

	if self:IsDoorOpen(
		Door
	)
	then
		return true
	end

	self:_SetStatus(
		"Opening door"
	)

	local Reached,
		Reason =
		self:NavigateTo(
			Trigger,

			Token,

			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		return false,
			Reason
	end

	local Settled,
		SettleReason =
		self:SettleIntoTrigger(
			Trigger,
			Token,
			nil
		)

	if not Settled then
		return false,
			SettleReason
	end

	if not self:PulseAction(
		Trigger,
		Token,
		0.14
	)
	then
		return false
	end

	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.DoorOpenTimeout
	do
		if self:IsDoorOpen(
			Door
		)
		then
			return true
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return self:IsDoorOpen(
		Door
	)
end

--------------------------------------------------
-- NAVIGATE WITH DOORS
--------------------------------------------------

function AutoPlay:NavigateWithDoors(
	Target,
	Token,
	Options
)
	Options =
		Options or {}

	local TargetPosition

	if typeof(Target)
		== "Vector3"
	then
		TargetPosition =
			Target

	elseif typeof(Target)
		== "CFrame"
	then
		TargetPosition =
			Target.Position

	elseif typeof(Target)
			== "Instance"
		and Target:IsA(
			"BasePart"
		)
	then
		TargetPosition =
			Target.Position

	else
		return false,
			"InvalidTarget"
	end

	local Door,
		DoorTrigger =
		self:FindDoorOnRoute(
			TargetPosition
		)

	if Door
		and DoorTrigger
	then
		local Opened,
			Reason =
			self:OpenDoor(
				Door,
				DoorTrigger,
				Token
			)

		if not Opened
			and Reason == "Threat"
		then
			return false,
				Reason
		end
	end

	local Reached,
		Reason =
		self:NavigateTo(
			Target,
			Token,
			Options
		)

	if Reached then
		return true,
			Reason
	end

	if Reason == "Blocked"
		or Reason == "Stuck"
		or Reason == "Repath"
	then
		Door,
			DoorTrigger =
			self:FindDoorOnRoute(
				TargetPosition
			)

		if Door
			and DoorTrigger
		then
			self:OpenDoor(
				Door,
				DoorTrigger,
				Token
			)

			return self:NavigateTo(
				Target,
				Token,
				Options
			)
		end
	end

	return false,
		Reason
end

--------------------------------------------------
-- HIDE FROM BEAST
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Humanoid.AutoRotate =
		false

	Root.Anchored =
		true

	local Down =
		TweenService:Create(
			Root,

			TweenInfo.new(
				self.Config.HideTweenTime,

				Enum.EasingStyle.Quad,

				Enum.EasingDirection.Out
			),

			{
				CFrame =
					HiddenCFrame,
			}
		)

	Down:Play()

	Down.Completed:Wait()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not Root.Parent then
		return false
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			OriginalAnchored

		Humanoid.AutoRotate =
			OriginalAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	local Up =
		TweenService:Create(
			Root,

			TweenInfo.new(
				self.Config.HideTweenTime,

				Enum.EasingStyle.Quad,

				Enum.EasingDirection.Out
			),

			{
				CFrame =
					ReturnCFrame,
			}
		)

	Up:Play()

	Up.Completed:Wait()

	Root.Anchored =
		OriginalAnchored

	Humanoid.AutoRotate =
		OriginalAutoRotate

	self:LeaveTrigger()

	task.wait(
		0.08
	)

	return true
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Going to computer"
	)

	--------------------------------------------------
	-- REAL PATH TO THE COMPUTER'S FLOOR
	--------------------------------------------------

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,

			Token,

			{
				Computer =
					Computer,

				Trigger =
					Trigger,

				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		if Reason == "Blocked"
			or Reason == "Stuck"
			or Reason == "WrongLevel"
		then
			self:MarkComputerUnreachable(
				Computer
			)
		end

		return false
	end

	--------------------------------------------------
	-- SAME COMPUTER RETRY LOOP
	--------------------------------------------------

	while self.Config.Enabled
		and Token
			== self._runToken
		and not self:IsComputerDone(
			Computer
		)
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		if self:IsTriggerOccupied(
			Trigger
		)
		then
			self:LeaveTrigger()

			return false
		end

		--------------------------------------------------
		-- GET ACTUALLY CLOSE
		--------------------------------------------------

		self:_SetStatus(
			"Positioning"
		)

		local Settled,
			SettleReason =
			self:SettleIntoTrigger(
				Trigger,
				Token,
				Computer
			)

		if not Settled then
			if SettleReason == "Threat" then
				self:HideFromBeast(
					Token
				)

				return false
			end

			--------------------------------------------------
			-- WRONG FLOOR:
			-- DO NOT STAND ABOVE IT FOREVER.
			--------------------------------------------------

			if SettleReason
				== "WrongLevel"
			then
				self:MarkComputerUnreachable(
					Computer
				)

				return false
			end

			--------------------------------------------------
			-- REPATH AND TRY AGAIN
			--------------------------------------------------

			self:_SetStatus(
				"Repositioning"
			)

			local Repositioned,
				RepositionReason =
				self:NavigateWithDoors(
					Trigger,

					Token,

					{
						Computer =
							Computer,

						Trigger =
							Trigger,

						ProjectToGround =
							true,
					}
				)

			if not Repositioned then
				if RepositionReason
					== "Threat"
				then
					self:HideFromBeast(
						Token
					)

					return false
				end

				self:MarkComputerUnreachable(
					Computer
				)

				return false
			end

			continue
		end

		--------------------------------------------------
		-- RED ERROR SCREEN
		--------------------------------------------------

		if self:IsComputerError(
			Computer
		)
		then
			local Recovered,
				ErrorReason =
				self:RecoverComputerError(
					Computer,
					Token
				)

			if not Recovered then
				if ErrorReason
					== "Threat"
				then
					self:HideFromBeast(
						Token
					)
				end

				return false
			end
		end

		--------------------------------------------------
		-- START HACK
		--------------------------------------------------

		self:_SetStatus(
			"Hacking"
		)

		if not self:StartAction(
			Trigger,
			Token
		)
		then
			task.wait(
				self.Config.HackRetryDelay
			)

			continue
		end

		local AttemptStarted =
			os.clock()

		local LastProgress =
			self:GetActionProgress()

		local LastProgressTime =
			os.clock()

		local Retry =
			false

		while self.Config.Enabled
			and Token
				== self._runToken
			and not self:IsComputerDone(
				Computer
			)
		do
			--------------------------------------------------
			-- BEAST
			--------------------------------------------------

			if self:IsBeastClose() then
				self:LeaveTrigger()

				self:HideFromBeast(
					Token
				)

				return false
			end

			--------------------------------------------------
			-- COMPUTER ERROR
			--------------------------------------------------

			if self:IsComputerError(
				Computer
			)
			then
				self:RecoverComputerError(
					Computer,
					Token
				)

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- SKILL CHECK
			--------------------------------------------------

			self:HandleSkillCheck()

			--------------------------------------------------
			-- PROGRESS
			--------------------------------------------------

			local Progress =
				self:GetActionProgress()

			self:_SetProgress(
				Progress
			)

			if Progress
				> LastProgress
					+ self.Config.HackProgressEpsilon
			then
				LastProgress =
					Progress

				LastProgressTime =
					os.clock()
			end

			--------------------------------------------------
			-- LOST TRIGGER
			--------------------------------------------------

			local OnTrigger =
				self:GetStatValue(
					"OnTrigger"
				)

			if OnTrigger == false then
				self:LeaveTrigger()

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- STALLED HACK
			--------------------------------------------------

			if os.clock()
					- LastProgressTime
					>= self.Config.HackStallRetryTime
			then
				self:_SetStatus(
					"Hack stalled - retrying"
				)

				self:LeaveTrigger()

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- ATTEMPT TIMEOUT
			--------------------------------------------------

			if os.clock()
					- AttemptStarted
					>= self.Config.ComputerTimeout
			then
				self:LeaveTrigger()

				Retry =
					true

				break
			end

			task.wait(
				0.05
			)
		end

		if self:IsComputerDone(
			Computer
		)
		then
			self:LeaveTrigger()

			self:_SetProgress(
				1
			)

			self:_SetStatus(
				"Computer complete"
			)

			return true
		end

		if Retry then
			self:LeaveTrigger()

			task.wait(
				self.Config.HackRetryDelay
			)
		end
	end

	self:LeaveTrigger()

	return self:IsComputerDone(
		Computer
	)
end

