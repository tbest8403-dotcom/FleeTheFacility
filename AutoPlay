--------------------------------------------------
-- DISTANCE TO LINE
--------------------------------------------------

local function DistanceToSegment(
	Point,
	A,
	B
)
	local AB =
		B - A

	local LengthSquared =
		AB:Dot(
			AB
		)

	if LengthSquared <= 0 then
		return (
			Point - A
		).Magnitude
	end

	local Alpha =
		(
			Point - A
		):Dot(
			AB
		)
		/ LengthSquared

	Alpha =
		math.clamp(
			Alpha,
			0,
			1
		)

	local Closest =
		A
		+ AB * Alpha

	return (
		Point - Closest
	).Magnitude,
		Alpha
end

--------------------------------------------------
-- FIND DOOR ALONG ROUTE
--------------------------------------------------

function AutoPlay:FindDoorOnRoute(
	StartPosition,
	TargetPosition
)
	local BestDoor = nil
	local BestTrigger = nil

	local BestAlpha =
		math.huge

	for _, Door
		in ipairs(
			self:GetDoors()
		)
	do
		local Trigger =
			self:GetDoorTrigger(
				Door
			)

		if Trigger then
			local Distance,
				Alpha =
				DistanceToSegment(
					Trigger.Position,
					StartPosition,
					TargetPosition
				)

			if Distance
				<= self.Config.DoorSearchRadius
				and Alpha > 0.05
				and Alpha < 0.95
				and Alpha
					< BestAlpha
			then
				BestDoor =
					Door

				BestTrigger =
					Trigger

				BestAlpha =
					Alpha
			end
		end
	end

	return BestDoor,
		BestTrigger
end

--------------------------------------------------
-- DOOR OPEN CHECK
--------------------------------------------------

function AutoPlay:IsDoorOpen(
	Door
)
	if not Door then
		return true
	end

	local OpenAttribute =
		Door:GetAttribute(
			"Open"
		)

	if OpenAttribute ~= nil then
		return OpenAttribute
			== true
	end

	local Trigger =
		self:GetDoorTrigger(
			Door
		)

	if Trigger then
		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		-- 10 = Open Door
		-- 11 = Close Door
		if ActionSign then
			return ActionSign.Value
				== 11
		end
	end

	return false
end

--------------------------------------------------
-- PATH CREATION
--------------------------------------------------

function AutoPlay:CreatePath(
	StartPosition,
	TargetPosition
)
	local Path =
		PathfindingService:CreatePath({
			AgentRadius =
				self.Config.AgentRadius,

			AgentHeight =
				self.Config.AgentHeight,

			AgentCanJump =
				self.Config.AgentCanJump,

			WaypointSpacing =
				self.Config.WaypointSpacing,
		})

	local Success =
		pcall(function()
			Path:ComputeAsync(
				StartPosition,
				TargetPosition
			)
		end)

	if not Success then
		return nil
	end

	if Path.Status
		~= Enum.PathStatus.Success
	then
		return nil
	end

	return Path
end

--------------------------------------------------
-- CANCEL MOVE
--------------------------------------------------

function AutoPlay:CancelMove()
	self._moveGeneration += 1

	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if Humanoid
		and Root
	then
		Humanoid:MoveTo(
			Root.Position
		)
	end
end

--------------------------------------------------
-- CHECK MOVEMENT
--------------------------------------------------

function AutoPlay:_CheckMovementState(
	Token,
	Generation,
	Options
)
	if not self.Config.Enabled then
		return false,
			"Stopped"
	end

	if Token ~= self._runToken then
		return false,
			"Stopped"
	end

	if Generation
		~= self._moveGeneration
	then
		return false,
			"Stopped"
	end

	if not Options.IgnoreThreat
		and self:IsBeastClose()
	then
		return false,
			"Threat"
	end

	if Options.Computer
		and self:IsComputerDone(
			Options.Computer
		)
	then
		return false,
			"Completed"
	end

	if Options.Trigger then
		local Occupied =
			self:IsTriggerOccupied(
				Options.Trigger
			)

		if Occupied then
			return false,
				"Occupied"
		end
	end

	return true,
		nil
end

--------------------------------------------------
-- FOLLOW WAYPOINT
--------------------------------------------------

function AutoPlay:_FollowWaypoint(
	Waypoint,
	Token,
	Generation,
	Options
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	if Waypoint.Action
		== Enum.PathWaypointAction.Jump
	then
		Humanoid.Jump =
			true
	end

	Humanoid:MoveTo(
		Waypoint.Position
	)

	local Started =
		os.clock()

	while true do
		local Valid,
			Reason =
			self:_CheckMovementState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		if not Root.Parent
			or not Humanoid.Parent
		then
			return false,
				"NoCharacter"
		end

		local Distance =
			(
				Root.Position
				- Waypoint.Position
			).Magnitude

		if Distance
			<= self.Config.ArrivalDistance
		then
			return true
		end

		if os.clock()
			- Started
			>= self.Config.WaypointTimeout
		then
			return false,
				"Blocked"
		end

		task.wait(
			0.03
		)
	end
end

--------------------------------------------------
-- WALK DIRECTLY
--------------------------------------------------

function AutoPlay:_WalkDirect(
	Position,
	Token,
	Generation,
	Options
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	Humanoid:MoveTo(
		Position
	)

	local Started =
		os.clock()

	while (
		Root.Position
		- Position
	).Magnitude
		> self.Config.ArrivalDistance
	do
		local Valid,
			Reason =
			self:_CheckMovementState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		if os.clock()
			- Started
			>= self.Config.WaypointTimeout
		then
			return false,
				"Blocked"
		end

		task.wait(
			0.03
		)
	end

	return true,
		"Reached"
end

--------------------------------------------------
-- OPEN DOOR
--------------------------------------------------

function AutoPlay:OpenDoor(
	Door,
	Trigger,
	Token,
	Generation
)
	if not Door
		or not Trigger
	then
		return false
	end

	if self:IsDoorOpen(
		Door
	)
	then
		return true
	end

	self:_SetStatus(
		"Opening door"
	)

	--------------------------------------------------
	-- WALK TO TRIGGER
	--------------------------------------------------

	local Path =
		self:CreatePath(
			self:GetRoot().Position,
			Trigger.Position
		)

	if Path then
		for _, Waypoint
			in ipairs(
				Path:GetWaypoints()
			)
		do
			local Success,
				Reason =
				self:_FollowWaypoint(
					Waypoint,
					Token,
					Generation,
					{
						IgnoreThreat =
							false,
					}
				)

			if not Success then
				return false,
					Reason
			end
		end
	else
		local Success,
			Reason =
			self:_WalkDirect(
				Trigger.Position,
				Token,
				Generation,
				{
					IgnoreThreat =
						false,
				}
			)

		if not Success then
			return false,
				Reason
		end
	end

	--------------------------------------------------
	-- AUTHORIZED DOOR ACTION
	--------------------------------------------------

	self:_Call(
		"OpenDoor",
		Door,
		Trigger
	)

	--------------------------------------------------
	-- WAIT FOR DOOR
	--------------------------------------------------

	local Started =
		os.clock()

	repeat
		if self:IsDoorOpen(
			Door
		)
		then
			return true
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)

	until os.clock()
		- Started
		>= self.Config.DoorOpenTimeout

	return self:IsDoorOpen(
		Door
	)
end

--------------------------------------------------
-- SMOOTH PATHFINDING
--------------------------------------------------

function AutoPlay:MoveTo(
	TargetCFrame,
	Token,
	Options
)
	Options =
		Options
		or {}

	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	--------------------------------------------------
	-- Uses Humanoid.WalkSpeed naturally.
	--------------------------------------------------

	self:CancelMove()

	local Generation =
		self._moveGeneration

	local TargetPosition =
		TargetCFrame.Position

	local Retry =
		0

	while Retry
		< self.Config.PathRetries
	do
		Retry += 1

		local Valid,
			Reason =
			self:_CheckMovementState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		--------------------------------------------------
		-- COMPUTE PATH
		--------------------------------------------------

		local Path =
			self:CreatePath(
				Root.Position,
				TargetPosition
			)

		if Path then
			local FailedReason =
				nil

			for _, Waypoint
				in ipairs(
					Path:GetWaypoints()
				)
			do
				local Success,
					WaypointReason =
					self:_FollowWaypoint(
						Waypoint,
						Token,
						Generation,
						Options
					)

				if not Success then
					FailedReason =
						WaypointReason

					break
				end
			end

			if not FailedReason then
				--------------------------------------------------
				-- FINAL APPROACH
				--------------------------------------------------

				return self:_WalkDirect(
					TargetPosition,
					Token,
					Generation,
					Options
				)
			end

			if FailedReason
				~= "Blocked"
			then
				return false,
					FailedReason
			end
		end

		--------------------------------------------------
		-- PATH FAILED / BLOCKED.
		-- LOOK FOR SINGLEDOOR.
		--------------------------------------------------

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		local Door,
			DoorTrigger =
			self:FindDoorOnRoute(
				Root.Position,
				TargetPosition
			)

		if Door
			and DoorTrigger
			and not self:IsDoorOpen(
				Door
			)
		then
			local Opened,
				DoorReason =
				self:OpenDoor(
					Door,
					DoorTrigger,
					Token,
					Generation
				)

			if not Opened
				and DoorReason
					~= nil
			then
				if DoorReason
					~= "Blocked"
				then
					return false,
						DoorReason
				end
			end

			task.wait(
				0.1
			)
		else
			--------------------------------------------------
			-- DIRECT FALLBACK
			--------------------------------------------------

			local Success,
				DirectReason =
				self:_WalkDirect(
					TargetPosition,
					Token,
					Generation,
					Options
				)

			if Success then
				return true,
					"Reached"
			end

			if DirectReason
				~= "Blocked"
			then
				return false,
					DirectReason
			end
		end
	end

	return false,
		"Blocked"
end

--------------------------------------------------
-- TWEEN BELOW WHEN BEAST CLOSE
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	self:CancelMove()

	self:_Call(
		"StopComputer"
	)

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	--------------------------------------------------
	-- TEMPORARILY STABILIZE CHARACTER
	--------------------------------------------------

	local WasAnchored =
		Root.Anchored

	local WasAutoRotate =
		Humanoid.AutoRotate

	Humanoid.AutoRotate =
		false

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Root.Anchored =
		true

	--------------------------------------------------
	-- DOWN TWEEN
	--------------------------------------------------

	local DownTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					HiddenCFrame,
			}
		)

	DownTween:Play()

	DownTween.Completed:Wait()

	--------------------------------------------------
	-- WAIT UNTIL SAFE
	--------------------------------------------------

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			WasAnchored

		Humanoid.AutoRotate =
			WasAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	--------------------------------------------------
	-- RETURN TWEEN
	--------------------------------------------------

	local UpTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					ReturnCFrame,
			}
		)

	UpTween:Play()

	UpTween.Completed:Wait()

	Root.Anchored =
		WasAnchored

	Humanoid.AutoRotate =
		WasAutoRotate

	return true
end

--------------------------------------------------
-- PROGRESS
--------------------------------------------------

function AutoPlay:GetActionProgress()
	local Value =
		self:_Call(
			"GetProgress"
		)

	return math.clamp(
		tonumber(Value)
			or 0,
		0,
		1
	)
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Walking to computer"
	)

	--------------------------------------------------
	-- WALK TO TRIGGER USING CURRENT WALKSPEED
	--------------------------------------------------

	local Arrived,
		Reason =
		self:MoveTo(
			CFrame.new(
				Trigger.Position
			),
			Token,
			{
				Computer =
					Computer,

				Trigger =
					Trigger,
			}
		)

	if not Arrived then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	--------------------------------------------------
	-- RECHECK
	--------------------------------------------------

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	if self:IsBeastClose() then
		self:HideFromBeast(
			Token
		)

		return false
	end

	--------------------------------------------------
	-- BEGIN AUTHORIZED COMPUTER ACTION
	--------------------------------------------------

	self:_SetStatus(
		"Hacking"
	)

	self:_Call(
		"UseComputer",
		Computer,
		Trigger
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsComputerDone(
			Computer
		)
		then
			self:_SetProgress(
				1
			)

			break
		end

		if self:IsBeastClose() then
			self:_Call(
				"StopComputer"
			)

			self:HideFromBeast(
				Token
			)

			return false
		end

		local Progress =
			self:GetActionProgress()

		self:_SetProgress(
			Progress
		)

		task.wait(
			0.05
		)
	end

	self:_Call(
		"StopComputer"
	)

	if self:IsComputerDone(
		Computer
	)
	then
		self:_SetStatus(
			"Computer complete"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- ALL COMPUTERS DONE
--------------------------------------------------

function AutoPlay:AreComputersDone()
	local Found =
		false

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		Found =
			true

		if not self:IsComputerDone(
			Computer
		)
		then
			return false
		end
	end

	return Found
end

--------------------------------------------------
-- EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local BestExit = nil
	local BestDistance =
		math.huge

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			local Trigger =
				Object:FindFirstChild(
					"ExitDoorTrigger",
					true
				)

			if Trigger
				and Trigger:IsA(
					"BasePart"
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestExit =
						Object
				end
			end
		end
	end

	return BestExit
end

function AutoPlay:UseExit(
	Exit,
	Token
)
	local Trigger =
		Exit
		and Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Walking to exit"
	)

	local Success,
		Reason =
		self:MoveTo(
			CFrame.new(
				Trigger.Position
			),
			Token,
			{}
		)

	if not Success then
		if Reason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	self:_SetStatus(
		"Opening exit"
	)

	self:_Call(
		"OpenExit",
		Exit,
		Trigger
	)

	--------------------------------------------------
	-- EXIT AREA
	--------------------------------------------------

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetStatus(
		"Walking through exit"
	)

	local Escaped =
		self:MoveTo(
			CFrame.new(
				ExitArea.Position
			),
			Token,
			{
				IgnoreThreat =
					true,
			}
		)

	if Escaped then
		self:_Call(
			"Escape",
			Exit,
			ExitArea
		)

		self:_SetStatus(
			"Escaped"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- SURVIVOR ROUTE
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- BEAST WITHIN 15 STUDS
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		--------------------------------------------------
		-- COMPUTERS
		--------------------------------------------------

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				self:_SetStatus(
					"Waiting for free computer"
				)

				task.wait(
					0.25
				)
			end

			continue
		end

		--------------------------------------------------
		-- EXIT
		--------------------------------------------------

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		if self:UseExit(
			Exit,
			Token
		)
		then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.25
		)
	end

	self:CancelMove()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		self:CancelMove()

		self:_Call(
			"StopComputer"
		)

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		return
	end

	task.spawn(function()
		self:_Run(
			Token
		)
	end)
end

