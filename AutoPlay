function AutoPlay:GetDoors()
	local Doors = {}

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "SingleDoor"
		then
			table.insert(
				Doors,
				Object
			)
		end
	end

	return Doors
