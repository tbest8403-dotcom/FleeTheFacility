					Bar

				local FillCorner =
					Instance.new(
						"UICorner"
					)

				FillCorner.CornerRadius =
					UDim.new(
						0,
						5
					)

				FillCorner.Parent =
					Fill

				local Percent =
					Instance.new(
						"TextLabel"
					)

				Percent.Size =
					UDim2.fromScale(
						1,
						1
					)

				Percent.BackgroundTransparency =
					1

				Percent.Text =
					"0%"

				Percent.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

				Percent.TextSize =
					11

				Percent.Font =
					Enum.Font.GothamBold

				Percent.ZIndex =
					2

				Percent.Parent =
					Bar

				self._progressFill =
					Fill

				self._progressLabel =
					Percent
			end,
	})

	Section:AddToggle({
		Name =
			"Auto Play",

		Default =
			false,

		Callback =
			function(
				Value
			)
				self:SetEnabled(
					Value
				)
			end,
	})

	Section:AddSlider({
		Name =
			"Beast Distance",

		Min =
			5,

		Max =
			50,

		Default =
			15,

		Increment =
			1,

		Callback =
			function(
				Value
			)
				self.Config.BeastAvoidDistance =
					Value

				self.Config.BeastResumeDistance =
					Value + 7
			end,
	})

	Section:AddSlider({
		Name =
			"Hide Depth",

		Min =
			8,

		Max =
			35,

		Default =
			self.Config.HideDepth,

		Increment =
			1,

		Callback =
			function(
				Value
			)
				self.Config.HideDepth =
					Value
			end,
	})
end

--------------------------------------------------
-- STOP
--------------------------------------------------

function AutoPlay:Stop()
	self:SetEnabled(
		false
	)
end

--------------------------------------------------
-- DESTROY
--------------------------------------------------

function AutoPlay:Destroy()
	self:Stop()

	print(
		("[FleeTheFacility] %s %s destroyed"):format(
			self.Name,
			self.Version
		)
	)
end

return AutoPlay
