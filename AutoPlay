			)
		end
	)
end

--------------------------------------------------
-- COLOR
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(
		A.R - B.R
	) <= Tolerance
		and math.abs(
			A.G - B.G
		) <= Tolerance
		and math.abs(
			A.B - B.B
		) <= Tolerance
end

