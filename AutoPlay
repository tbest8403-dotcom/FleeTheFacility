local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local AutoPlay = {}

--------------------------------------------------
-- CONFIG
--------------------------------------------------

AutoPlay.Config = {
	Enabled = false,

	MoveSpeed = 28,

	ComputerOffset = Vector3.new(
		0,
		2.5,
		0
	),

	ExitOffset = Vector3.new(
		0,
		2.5,
		0
	),

	BeastAvoidDistance = 55,
	BeastResumeDistance = 75,

	HideDepth = 16,

	TriggerOccupancyRadius = 4.5,

	AutoSkillCheck = true,

	InteractionTimeout = 35,

	ComputerDoneColor =
		Color3.fromRGB(
			40,
			127,
			71
		),
}

--------------------------------------------------
-- STATE
--------------------------------------------------

AutoPlay._runToken = 0
AutoPlay._currentTween = nil

AutoPlay._statusLabel = nil
AutoPlay._objectiveLabel = nil

AutoPlay._progressLabel = nil
AutoPlay._progressFill = nil

AutoPlay._initialized = false

AutoPlay._remote = nil
AutoPlay._computersLeft = nil
AutoPlay._stats = nil

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(A.R - B.R)
			<= Tolerance
		and math.abs(A.G - B.G)
			<= Tolerance
		and math.abs(A.B - B.B)
			<= Tolerance
end

--------------------------------------------------
-- UI
--------------------------------------------------

function AutoPlay:_SetStatus(Text)
	if self._statusLabel then
		self._statusLabel:SetText(
			"Status: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetObjective(Text)
	if self._objectiveLabel then
		self._objectiveLabel:SetText(
			"Objective: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetProgress(Value)
	Value =
		math.clamp(
			tonumber(Value)
				or 0,
			0,
			1
		)

	if self._progressFill then
		self._progressFill.Size =
			UDim2.fromScale(
				Value,
				1
			)
	end

	if self._progressLabel then
		self._progressLabel.Text =
			("%d%%"):format(
				math.floor(
					Value * 100
				)
			)
	end
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

function AutoPlay:GetCharacter()
	return LocalPlayer.Character
end

function AutoPlay:GetRoot()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- PLAYER STATS
--------------------------------------------------

function AutoPlay:GetStats(Player)
	if not Player then
		return nil
	end

	local ModuleScript =
		Player:FindFirstChild(
			"TempPlayerStatsModule"
		)

	if not ModuleScript then
		return nil
	end

	local Success, Result =
		pcall(
			require,
			ModuleScript
		)

	if Success then
		return Result
	end

	return nil
end

--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(Player)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(Player)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success, Result =
			pcall(function()
				return Stats.GetValue(
					"IsBeast"
				)
			end)

		if Success
			and Result == true
		then
			return true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- OBJECT POSITION
--------------------------------------------------

function AutoPlay:GetPosition(Object)
	if not Object then
		return nil
	end

	if Object:IsA("BasePart") then
		return Object.Position
	end

	if Object:IsA("Model") then
		return Object:GetPivot().Position
	end

	local Part =
		Object:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	if Part then
		return Part.Position
	end

	return nil
end

--------------------------------------------------
-- COMPUTER FINISHED CHECK
--------------------------------------------------

function AutoPlay:IsComputerDone(
	Computer
)
	if not Computer then
		return true
	end

	local Screen =
		Computer:FindFirstChild(
			"Screen"
		)

	if Screen
		and Screen:IsA(
			"BasePart"
		)
	then
		if ColorsMatch(
			Screen.Color,
			self.Config.ComputerDoneColor
		)
		then
			return true
		end
	end

	--------------------------------------------------
	-- OPTIONAL FALLBACKS
	--------------------------------------------------

	if Computer:GetAttribute(
		"Completed"
	) == true
	then
		return true
	end

	if Computer:GetAttribute(
		"Hacked"
	) == true
	then
		return true
	end

	return false
end

--------------------------------------------------
-- VALID COMPUTER TRIGGER
--------------------------------------------------

function AutoPlay:IsValidComputerTrigger(
	Trigger
)
	if not Trigger then
		return false
	end

	if not Trigger:IsA(
		"BasePart"
	) then
		return false
	end

	local ActionSign =
		Trigger:FindFirstChild(
			"ActionSign"
		)

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not ActionSign
		or not Event
	then
		return false
	end

	if ActionSign.Value
		~= 20
	then
		return false
	end

	return true
end

--------------------------------------------------
-- TRIGGER OCCUPANCY
--------------------------------------------------

function AutoPlay:IsTriggerOccupied(
	Trigger
)
	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return true
	end

	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer then
			local Character =
				Player.Character

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if Root
				and (
					not Humanoid
					or Humanoid.Health > 0
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					<= self.Config.TriggerOccupancyRadius
				then
					return true,
						Player
				end
			end
		end
	end

	return false,
		nil
end

--------------------------------------------------
-- GET COMPUTER TRIGGERS
--------------------------------------------------

function AutoPlay:GetComputerTriggers(
	Computer
)
	local Results = {}

	if not Computer then
		return Results
	end

	for Index = 1, 3 do
		local Trigger =
			Computer:FindFirstChild(
				"ComputerTrigger"
					.. Index,
				true
			)

		if self:IsValidComputerTrigger(
			Trigger
		)
		then
			table.insert(
				Results,
				Trigger
			)
		end
	end

	return Results
end

--------------------------------------------------
-- AVAILABLE TRIGGERS
--------------------------------------------------

function AutoPlay:GetAvailableTriggers(
	Computer
)
	local Available = {}

	for _, Trigger
		in ipairs(
			self:GetComputerTriggers(
				Computer
			)
		)
	do
		local Occupied =
			self:IsTriggerOccupied(
				Trigger
			)

		if not Occupied then
			table.insert(
				Available,
				Trigger
			)
		end
	end

	return Available
end

--------------------------------------------------
-- COMPUTERS
--------------------------------------------------

function AutoPlay:GetComputers()
	local Results = {}

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ComputerTable"
		then
			table.insert(
				Results,
				Object
			)
		end
	end

	return Results
end

--------------------------------------------------
-- NEAREST FREE COMPUTER/TRIGGER
--------------------------------------------------

function AutoPlay:GetNearestComputerTarget()
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestComputer = nil
	local BestTrigger = nil

	local BestDistance =
		math.huge

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		--------------------------------------------------
		-- SKIP GREEN / DONE
		--------------------------------------------------

		if not self:IsComputerDone(
			Computer
		)
		then
			--------------------------------------------------
			-- CHECK ALL THREE SPOTS
			--------------------------------------------------

			local AvailableTriggers =
				self:GetAvailableTriggers(
					Computer
				)

			for _, Trigger
				in ipairs(
					AvailableTriggers
				)
			do
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestComputer =
						Computer

					BestTrigger =
						Trigger
				end
			end
		end
	end

	return BestComputer,
		BestTrigger
end

--------------------------------------------------
-- EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local Best = nil

	local BestDistance =
		math.huge

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			local Position =
				self:GetPosition(
					Object
				)

			if Position then
				local Distance =
					(
						Root.Position
						- Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					Best =
						Object
				end
			end
		end
	end

	return Best
end

--------------------------------------------------
-- TWEEN
--------------------------------------------------

function AutoPlay:CancelTween()
	if self._currentTween then
		pcall(function()
			self._currentTween:Cancel()
		end)

		self._currentTween =
			nil
	end
end

function AutoPlay:MoveTo(
	TargetCFrame,
	Token,
	Options
)
	Options =
		Options
		or {}

	local Root =
		self:GetRoot()

	if not Root then
		return false,
			"NoCharacter"
	end

	self:CancelTween()

	local Distance =
		(
			Root.Position
			- TargetCFrame.Position
		).Magnitude

	local Duration =
		Distance
		/ math.max(
			self.Config.MoveSpeed,
			1
		)

	Duration =
		math.max(
			Duration,
			0.05
		)

	local Tween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				Duration,
				Enum.EasingStyle.Linear
			),
			{
				CFrame =
					TargetCFrame,
			}
		)

	self._currentTween =
		Tween

	Tween:Play()

	while self._currentTween
		== Tween
		and Tween.PlaybackState
			== Enum.PlaybackState.Playing
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			Tween:Cancel()

			return false,
				"Stopped"
		end

		--------------------------------------------------
		-- BEAST
		--------------------------------------------------

		if not Options.IgnoreThreat
			and self:IsBeastClose()
		then
			Tween:Cancel()

			return false,
				"Threat"
		end

		--------------------------------------------------
		-- TRIGGER GOT TAKEN
		--------------------------------------------------

		if Options.Trigger then
			local Occupied =
				self:IsTriggerOccupied(
					Options.Trigger
				)

			if Occupied then
				Tween:Cancel()

				return false,
					"Occupied"
			end
		end

		--------------------------------------------------
		-- COMPUTER FINISHED WHILE MOVING
		--------------------------------------------------

		if Options.Computer
			and self:IsComputerDone(
				Options.Computer
			)
		then
			Tween:Cancel()

			return false,
				"Completed"
		end

		task.wait(
			0.05
		)
	end

	if self._currentTween
		== Tween
	then
		self._currentTween =
			nil
	end

	return true,
		"Reached"
end

--------------------------------------------------
-- INTERACTION
--------------------------------------------------

function AutoPlay:StartInteraction(
	Trigger
)
	if not Trigger
		or not self._remote
	then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	self._remote:FireServer(
		"Input",
		"Trigger",
		true,
		Event
	)

	task.wait(
		0.08
	)

	self._remote:FireServer(
		"Input",
		"Action",
		true
	)

	if self._stats
		and type(
			self._stats.SetValue
		) == "function"
	then
		pcall(function()
			self._stats.SetValue(
				"ActionInput",
				true
			)
		end)
	end

	return true
end

function AutoPlay:StopInteraction()
	if not self._remote then
		return
	end

	self._remote:FireServer(
		"Input",
		"Action",
		false
	)

	self._remote:FireServer(
		"Input",
		"Trigger",
		false
	)

	if self._stats
		and type(
			self._stats.SetValue
		) == "function"
	then
		pcall(function()
			self._stats.SetValue(
				"ActionInput",
				false
			)
		end)
	end

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ACTION PROGRESS
--------------------------------------------------

function AutoPlay:GetActionProgress()
	if not self._stats
		or type(
			self._stats.GetValue
		) ~= "function"
	then
		return 0
	end

	local Success, Value =
		pcall(function()
			return self._stats.GetValue(
				"ActionProgress"
			)
		end)

	if not Success then
		return 0
	end

	return tonumber(Value)
		or 0
end

--------------------------------------------------
-- SKILL CHECK
--------------------------------------------------

function AutoPlay:HandleSkillCheck()
	if not self.Config.AutoSkillCheck
		or not self._stats
		or not self._remote
	then
		return
	end

	local Success, Goal =
		pcall(function()
			return self._stats.GetValue(
				"TimingGoalPosition"
			)
		end)

	if not Success then
		return
	end

	if tonumber(Goal)
		and Goal > 0
	then
		self._remote:FireServer(
			"SetPlayerMinigameResult",
			true
		)
	end
end

--------------------------------------------------
-- HIDE
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	if not Root then
		return false
	end

	self:StopInteraction()

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	self:MoveTo(
		HiddenCFrame,
		Token,
		{
			IgnoreThreat =
				true,
		}
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:GetBeastDistance()
			>= self.Config.BeastResumeDistance
		then
			break
		end

		task.wait(
			0.15
		)
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		return false
	end

	self:_SetStatus(
		"Returning"
	)

	self:MoveTo(
		ReturnCFrame,
		Token,
		{
			IgnoreThreat =
				true,
		}
	)

	return true
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	--------------------------------------------------
	-- COMPUTER ALREADY DONE
	--------------------------------------------------

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	--------------------------------------------------
	-- TRIGGER ALREADY TAKEN
	--------------------------------------------------

	local Occupied =
		self:IsTriggerOccupied(
			Trigger
		)

	if Occupied then
		self:_SetStatus(
			"Spot taken - switching"
		)

		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Moving to computer"
	)

	local Arrived, Reason =
		self:MoveTo(
			Trigger.CFrame
				+ self.Config.ComputerOffset,
			Token,
			{
				Computer =
					Computer,

				Trigger =
					Trigger,
			}
		)

	if not Arrived then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)

		elseif Reason
			== "Occupied"
		then
			self:_SetStatus(
				"Spot taken - switching"
			)

		elseif Reason
			== "Completed"
		then
			self:_SetStatus(
				"Computer already complete"
			)
		end

		return false
	end

	--------------------------------------------------
	-- CHECK AGAIN AFTER ARRIVAL
	--------------------------------------------------

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	Occupied =
		self:IsTriggerOccupied(
			Trigger
		)

	if Occupied then
		self:_SetStatus(
			"Spot taken - switching"
		)

		return false
	end

	if self:IsBeastClose() then
		self:HideFromBeast(
			Token
		)

		return false
	end

	--------------------------------------------------
	-- START HACKING
	--------------------------------------------------

	self:_SetStatus(
		"Hacking"
	)

	if not self:StartInteraction(
		Trigger
	)
	then
		self:_SetStatus(
			"Interaction failed"
		)

		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- COMPUTER TURNED GREEN
		--------------------------------------------------

		if self:IsComputerDone(
			Computer
		)
		then
			self:_SetProgress(
				1
			)

			break
		end

		--------------------------------------------------
		-- BEAST
		--------------------------------------------------

		if self:IsBeastClose() then
			self:StopInteraction()

			self:HideFromBeast(
				Token
			)

			return false
		end

		--------------------------------------------------
		-- PROGRESS
		--------------------------------------------------

		local Progress =
			self:GetActionProgress()

		self:_SetProgress(
			Progress
		)

		self:HandleSkillCheck()

		--------------------------------------------------
		-- TIMEOUT
		--------------------------------------------------

		if os.clock()
			- Started
			>= self.Config.InteractionTimeout
		then
			self:_SetStatus(
				"Hack timed out"
			)

			break
		end

		task.wait(
			0.05
		)
	end

	self:StopInteraction()

	if self:IsComputerDone(
		Computer
	)
	then
		self:_SetStatus(
			"Computer complete"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- ALL COMPUTERS FINISHED
--------------------------------------------------

function AutoPlay:AreComputersDone()
	if self._computersLeft then
		local Value =
			tonumber(
				self._computersLeft.Value
			)

		if Value ~= nil
			and Value <= 0
		then
			return true
		end
	end

	local FoundComputer =
		false

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		FoundComputer =
			true

		if not self:IsComputerDone(
			Computer
		)
		then
			return false
		end
	end

	return FoundComputer
end

--------------------------------------------------
-- USE EXIT
--------------------------------------------------

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if Trigger
		and Trigger:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Moving to exit"
		)

		local Arrived, Reason =
			self:MoveTo(
				Trigger.CFrame
					+ self.Config.ExitOffset,
				Token,
				{}
			)

		if not Arrived then
			if Reason
				== "Threat"
			then
				self:HideFromBeast(
					Token
				)
			end

			return false
		end

		self:_SetStatus(
			"Opening exit"
		)

		self:StartInteraction(
			Trigger
		)

		local Started =
			os.clock()

		while self.Config.Enabled
			and Token
				== self._runToken
		do
			if self:IsBeastClose() then
				self:StopInteraction()

				self:HideFromBeast(
					Token
				)

				return false
			end

			local Progress =
				self:GetActionProgress()

			self:_SetProgress(
				Progress
			)

			self:HandleSkillCheck()

			local ActionSign =
				Trigger:FindFirstChild(
					"ActionSign"
				)

			if ActionSign
				and ActionSign.Value
					~= 12
			then
				break
			end

			if os.clock()
				- Started
				>= 15
			then
				break
			end

			task.wait(
				0.05
			)
		end

		self:StopInteraction()
	end

	--------------------------------------------------
	-- EXIT AREA
	--------------------------------------------------

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Success =
		self:MoveTo(
			ExitArea.CFrame
				+ Vector3.new(
					0,
					1,
					0
				),
			Token,
			{
				IgnoreThreat =
					true,
			}
		)

	if not Success then
		return false
	end

	local Root =
		self:GetRoot()

	if Root then
		Root.CFrame =
			ExitArea.CFrame
	end

	task.wait(
		0.4
	)

	self:_SetStatus(
		"Escaped"
	)

	return true
end

--------------------------------------------------
-- LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- DON'T RUN SURVIVOR ROUTE AS BEAST
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				1
			)

			continue
		end

		--------------------------------------------------
		-- BEAST NEARBY
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			task.wait(
				0.1
			)

			continue
		end

		--------------------------------------------------
		-- COMPUTERS
		--------------------------------------------------

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				--------------------------------------------------
				-- ALL CURRENT COMPUTER SPOTS TAKEN
				--------------------------------------------------

				self:_SetObjective(
					"Computer"
				)

				self:_SetStatus(
					"Waiting for free computer spot"
				)

				task.wait(
					0.4
				)
			end

			continue
		end

		--------------------------------------------------
		-- EXIT
		--------------------------------------------------

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		local Escaped =
			self:UseExit(
				Exit,
				Token
			)

		if Escaped then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.25
		)
	end

	self:CancelTween()

	self:StopInteraction()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		self:CancelTween()

		self:StopInteraction()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		return
	end

	task.spawn(function()
		self:_Run(
			Token
		)
	end)
end

--------------------------------------------------
-- INIT
--------------------------------------------------

function AutoPlay:Init()
	if self._initialized then
		return
	end

	self._initialized =
		true

	self._remote =
		ReplicatedStorage:WaitForChild(
			"RemoteEvent"
		)

	self._computersLeft =
		ReplicatedStorage:FindFirstChild(
			"ComputersLeft"
		)

	local StatsModule =
		LocalPlayer:WaitForChild(
			"TempPlayerStatsModule"
		)

	self._stats =
		require(
			StatsModule
		)
end

