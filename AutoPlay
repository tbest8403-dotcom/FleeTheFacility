--------------------------------------------------
-- COLOR MATCH
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(
		A.R - B.R
	) <= Tolerance
		and math.abs(
			A.G - B.G
		) <= Tolerance
		and math.abs(
			A.B - B.B
		) <= Tolerance
end

--------------------------------------------------
-- COMPUTER DONE
--------------------------------------------------

function AutoPlay:IsComputerDone(
	Computer
)
	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	return ColorsMatch(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

--------------------------------------------------
-- COMPUTER ERROR
--------------------------------------------------

function AutoPlay:IsComputerError(
	Computer
)
	if self:IsComputerDone(
		Computer
	)
	then
		return false
	end

	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	local Color =
		Screen.Color

	if Color.R
		< self.Config.ErrorMinimumRed
	then
		return false
	end

	local Dominance =
		Color.R
		- math.max(
			Color.G,
			Color.B
		)

	return Dominance
		>= self.Config.ErrorRedDominance
end

--------------------------------------------------
-- RECOVER ERROR
--------------------------------------------------

function AutoPlay:RecoverComputerError(
	Computer,
	Token
)
	self:_SetStatus(
		"Computer error - recovering"
	)

	self:LeaveTrigger()

	task.wait(
		self.Config.ErrorWaitTime
	)

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:IsComputerError(
			Computer
		)
		and os.clock()
			- Started
			< self.Config.ErrorMaximumWait
	do
		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return true
end

