--------------------------------------------------
-- TRIGGERS
--------------------------------------------------

function AutoPlay:GetComputerTriggers(
	Computer
)
	local Results = {}

	for Index = 1, 3 do
		local Trigger =
			Computer:FindFirstChild(
				"ComputerTrigger"
					.. Index,
				true
			)

		if Trigger
			and Trigger:IsA(
				"BasePart"
			)
		then
			table.insert(
				Results,
				Trigger
			)
		end
	end

	return Results
end

--------------------------------------------------
-- OCCUPANCY
--------------------------------------------------

function AutoPlay:IsTriggerOccupied(
	Trigger
)
	if not Trigger then
		return true
	end

	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer then
			local Character =
				Player.Character

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if Root
				and (
					not Humanoid
					or Humanoid.Health > 0
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					<= self.Config.TriggerOccupancyRadius
				then
					return true,
						Player
				end
			end
		end
	end

	return false,
		nil
end

--------------------------------------------------
-- AVAILABLE TRIGGERS
--------------------------------------------------

function AutoPlay:GetAvailableTriggers(
	Computer
)
	local Available = {}

	for _, Trigger
		in ipairs(
			self:GetComputerTriggers(
				Computer
			)
		)
	do
		local Occupied =
			self:IsTriggerOccupied(
				Trigger
			)

		if not Occupied then
			table.insert(
				Available,
				Trigger
			)
		end
	end

	return Available
end

--------------------------------------------------
-- NEAREST COMPUTER/TRIGGER
--------------------------------------------------

function AutoPlay:GetNearestComputerTarget()
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestComputer = nil
	local BestTrigger = nil

	local BestDistance =
		math.huge

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		if not self:IsComputerDone(
			Computer
		)
		then
			local Triggers =
				self:GetAvailableTriggers(
					Computer
				)

			for _, Trigger
				in ipairs(
					Triggers
				)
			do
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestComputer =
						Computer

					BestTrigger =
						Trigger
				end
			end
		end
	end

	return BestComputer,
		BestTrigger
end

