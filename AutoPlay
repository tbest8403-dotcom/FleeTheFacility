-- COMPUTER TRIGGER CENTER DISTANCE
--------------------------------------------------

function AutoPlay:GetTriggerHorizontalDistance(
	Trigger
)
	local Root =
		self:GetRoot()

	if not Root
		or not Trigger
	then
		return math.huge
	end

	local Difference =
		Trigger.Position
		- Root.Position

	return Vector3.new(
		Difference.X,
		0,
		Difference.Z
	).Magnitude
end

--------------------------------------------------
-- MOVE VERY CLOSE TO COMPUTER
--------------------------------------------------

function AutoPlay:SettleIntoTrigger(
	Trigger,
	Token
)
	if not Trigger
		or not Trigger.Parent
	then
		return false,
			"MissingTrigger"
	end

	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	local Destination =
		Vector3.new(
			Trigger.Position.X,
			Root.Position.Y,
			Trigger.Position.Z
		)

	Humanoid:MoveTo(
		Destination
	)

	local Started =
		os.clock()

	local LastPosition =
		Root.Position

	local LastMovementTime =
		os.clock()

	local LastJumpTime =
		0

	while os.clock()
		- Started
		< self.Config.TriggerMoveTimeout
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false,
				"Stopped"
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		Root =
			self:GetRoot()

		Humanoid =
			self:GetHumanoid()

		if not Root
			or not Humanoid
		then
			return false,
				"NoCharacter"
		end

		local Distance =
			self:GetTriggerHorizontalDistance(
				Trigger
			)

		--------------------------------------------------
		-- ACTUALLY CLOSE ENOUGH
		--------------------------------------------------

		if Distance
			<= self.Config.ComputerCenterDistance
		then
			Humanoid:MoveTo(
				Root.Position
			)

			task.wait(
				self.Config.TriggerSettleTime
			)

			return true,
				"Reached"
		end

		--------------------------------------------------
		-- TRACK MOVEMENT
		--------------------------------------------------

		if (
			Root.Position
			- LastPosition
		).Magnitude
			>= 0.25
		then
			LastPosition =
				Root.Position

			LastMovementTime =
				os.clock()
		end

		--------------------------------------------------
		-- BOXED IN NEAR COMPUTER -> JUMP
		--------------------------------------------------

		if os.clock()
				- LastMovementTime
				>= 0.4
			and Humanoid.FloorMaterial
				~= Enum.Material.Air
			and os.clock()
				- LastJumpTime
				>= 0.25
		then
			LastJumpTime =
				os.clock()

			Humanoid.Jump =
				true

			Humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)

			Humanoid:MoveTo(
				Destination
			)

			LastMovementTime =
				os.clock()
		end

		RunService.Heartbeat:Wait()
	end

	return self:GetTriggerHorizontalDistance(
		Trigger
	) <= self.Config.ComputerCenterDistance,
		"TriggerPositionTimeout"
end

