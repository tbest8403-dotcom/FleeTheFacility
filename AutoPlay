--------------------------------------------------
-- COLOR MATCH
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(
		A.R - B.R
	) <= Tolerance
		and math.abs(
			A.G - B.G
		) <= Tolerance
		and math.abs(
			A.B - B.B
		) <= Tolerance
end

--------------------------------------------------
-- COMPUTER DONE
--------------------------------------------------

function AutoPlay:IsComputerDone(
	Computer
)
	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	return ColorsMatch(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

--------------------------------------------------
-- COMPUTER ERROR
--------------------------------------------------

function AutoPlay:IsComputerError(
	Computer
)
	if self:IsComputerDone(
		Computer
	)
	then
		return false
	end

	local Screen =
		self:GetComputerScreen(
			Computer
		)

	if not Screen then
		return false
	end

	local Color =
		Screen.Color

	if Color.R
		< self.Config.ErrorMinimumRed
	then
		return false
	end

	local Dominance =
		Color.R
		- math.max(
			Color.G,
			Color.B
		)

	return Dominance
		>= self.Config.ErrorRedDominance
end

--------------------------------------------------
-- ERROR RECOVERY
--------------------------------------------------

function AutoPlay:RecoverComputerError(
	Computer,
	Token
)
	self:_SetStatus(
		"Computer error - retrying"
	)

	self:LeaveTrigger()

	task.wait(
		self.Config.ErrorRetryDelay
	)

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:IsComputerError(
			Computer
		)
		and os.clock()
			- Started
			< self.Config.ErrorMaximumWait
	do
		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return true,
		"Recovered"
end

--------------------------------------------------
-- COMPUTERS
--------------------------------------------------

function AutoPlay:GetComputers()
	local Results = {}

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ComputerTable"
		then
			table.insert(
				Results,
				Object
			)
		end
	end

	return Results
end

--------------------------------------------------
-- UNFINISHED COMPUTERS
--------------------------------------------------

function AutoPlay:GetUnfinishedComputers()
	local Results = {}

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		if not self:IsComputerDone(
			Computer
		)
		then
			table.insert(
				Results,
				Computer
			)
		end
	end

	return Results
end

--------------------------------------------------
-- COMPUTER TRIGGERS
--------------------------------------------------

function AutoPlay:GetComputerTriggers(
	Computer
)
	local Results = {}

	if not Computer then
		return Results
	end

	for Index = 1, 3 do
		local Trigger =
			Computer:FindFirstChild(
				"ComputerTrigger"
					.. Index,
				true
			)

		if Trigger
			and Trigger:IsA(
				"BasePart"
			)
		then
			local ActionSign =
				Trigger:FindFirstChild(
					"ActionSign"
				)

			local Event =
				Trigger:FindFirstChild(
					"Event"
				)

			if ActionSign
				and Event
				and ActionSign.Value
					== 20
			then
				table.insert(
					Results,
					Trigger
				)
			end
		end
	end

	return Results
end

--------------------------------------------------
-- OCCUPANCY
--------------------------------------------------

function AutoPlay:IsTriggerOccupied(
	Trigger
)
	if not Trigger then
		return true
	end

	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer then
			local Character =
				Player.Character

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			if Root
				and Humanoid
				and Humanoid.Health > 0
				and (
					Root.Position
					- Trigger.Position
				).Magnitude
					<= self.Config.TriggerOccupancyRadius
			then
				return true,
					Player
			end
		end
	end

	return false,
		nil
end

--------------------------------------------------
-- AVAILABLE TRIGGER
--------------------------------------------------

function AutoPlay:GetAvailableTrigger(
	Computer
)
	local Root =
		self:GetRoot()

	local BestTrigger =
		nil

	local BestDistance =
		math.huge

	for _, Trigger
		in ipairs(
			self:GetComputerTriggers(
				Computer
			)
		)
	do
		if not self:IsTriggerOccupied(
			Trigger
		)
		then
			local Distance =
				Root
				and (
					Root.Position
					- Trigger.Position
				).Magnitude
				or 0

			if Distance < BestDistance then
				BestDistance =
					Distance

				BestTrigger =
					Trigger
			end
		end
	end

	return BestTrigger
end

--------------------------------------------------
-- NEAREST UNFINISHED COMPUTER
--------------------------------------------------

function AutoPlay:GetNearestComputerTarget()
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestComputer =
		nil

	local BestTrigger =
		nil

	local BestDistance =
		math.huge

	for _, Computer
		in ipairs(
			self:GetUnfinishedComputers()
		)
	do
		local Trigger =
			self:GetAvailableTrigger(
				Computer
			)

		if Trigger then
			local Distance =
				(
					Root.Position
					- Trigger.Position
				).Magnitude

			if Distance < BestDistance then
				BestDistance =
					Distance

				BestComputer =
					Computer

				BestTrigger =
					Trigger
			end
		end
	end

	return BestComputer,
		BestTrigger
end

--------------------------------------------------
-- HIDE FROM BEAST
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	self:CancelTravel()

	self:LeaveTrigger()

	local ReturnCFrame =
		Root.CFrame

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	Root.Anchored =
		true

	Humanoid.AutoRotate =
		false

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	local Down =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					HiddenCFrame,
			}
		)

	Down:Play()
	Down.Completed:Wait()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not Root.Parent then
		return false
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			OriginalAnchored

		Humanoid.AutoRotate =
			OriginalAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	local Up =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					ReturnCFrame,
			}
		)

	Up:Play()
	Up.Completed:Wait()

	Root.Anchored =
		OriginalAnchored

	Humanoid.AutoRotate =
		OriginalAutoRotate

	self:LeaveTrigger()

	return true
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Going to computer"
	)

	--------------------------------------------------
	-- DOWN -> UNDER COMPUTER -> UP
	--------------------------------------------------

	local Reached,
		Reason =
		self:SmoothTravelTo(
			Trigger,
			Token,
			false
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	--------------------------------------------------
	-- STAY ON SAME COMPUTER AND RETRY
	--------------------------------------------------

	while self.Config.Enabled
		and Token
			== self._runToken
		and not self:IsComputerDone(
			Computer
		)
	do
		--------------------------------------------------
		-- BEAST
		--------------------------------------------------

		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		--------------------------------------------------
		-- CURRENT SLOT OCCUPIED
		--------------------------------------------------

		if self:IsTriggerOccupied(
			Trigger
		)
		then
			local Replacement =
				self:GetAvailableTrigger(
					Computer
				)

			if not Replacement then
				return false
			end

			if Replacement
				~= Trigger
			then
				Trigger =
					Replacement

				local Moved,
					MoveReason =
					self:SmoothTravelTo(
						Trigger,
						Token,
						false
					)

				if not Moved then
					if MoveReason
						== "Threat"
					then
						self:HideFromBeast(
							Token
						)
					end

					return false
				end
			end
		end

		--------------------------------------------------
		-- ERROR COLOR
		--------------------------------------------------

		if self:IsComputerError(
			Computer
		)
		then
			local Recovered,
				ErrorReason =
				self:RecoverComputerError(
					Computer,
					Token
				)

			if not Recovered then
				if ErrorReason
					== "Threat"
				then
					self:HideFromBeast(
						Token
					)
				end

				return false
			end
		end

		--------------------------------------------------
		-- MAKE SURE WE ARE STILL AT THE COMPUTER
		--------------------------------------------------

		local Root =
			self:GetRoot()

		if not Root then
			return false
		end

		if (
			Root.Position
			- Trigger.Position
		).Magnitude
			> self.Config.InteractionDistance
		then
			local Moved,
				MoveReason =
				self:SmoothTravelTo(
					Trigger,
					Token,
					false
				)

			if not Moved then
				if MoveReason
					== "Threat"
				then
					self:HideFromBeast(
						Token
					)
				end

				return false
			end
		end

		--------------------------------------------------
		-- START HACK
		--------------------------------------------------

		self:_SetStatus(
			"Hacking"
		)

		if not self:StartAction(
			Trigger,
			Token
		)
		then
			self:LeaveTrigger()

			task.wait(
				self.Config.HackRetryDelay
			)

			continue
		end

		local AttemptStarted =
			os.clock()

		local LastProgress =
			self:GetActionProgress()

		local LastProgressTime =
			os.clock()

		local Retry =
			false

		while self.Config.Enabled
			and Token
				== self._runToken
			and not self:IsComputerDone(
				Computer
			)
		do
			--------------------------------------------------
			-- BEAST
			--------------------------------------------------

			if self:IsBeastClose() then
				self:LeaveTrigger()

				self:HideFromBeast(
					Token
				)

				return false
			end

			--------------------------------------------------
			-- ERROR
			--------------------------------------------------

			if self:IsComputerError(
				Computer
			)
			then
				self:LeaveTrigger()

				local Recovered,
					ErrorReason =
					self:RecoverComputerError(
						Computer,
						Token
					)

				if not Recovered
					and ErrorReason
						== "Threat"
				then
					self:HideFromBeast(
						Token
					)

					return false
				end

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- SKILL CHECK
			--------------------------------------------------

			self:HandleSkillCheck()

			--------------------------------------------------
			-- PROGRESS
			--------------------------------------------------

			local Progress =
				self:GetActionProgress()

			self:_SetProgress(
				Progress
			)

			if Progress
				> LastProgress
					+ self.Config.HackProgressEpsilon
			then
				LastProgress =
					Progress

				LastProgressTime =
					os.clock()
			end

			--------------------------------------------------
			-- LOST TRIGGER
			--------------------------------------------------

			local OnTrigger =
				self:GetStatValue(
					"OnTrigger"
				)

			if OnTrigger == false then
				self:_SetStatus(
					"Retrying hack"
				)

				self:LeaveTrigger()

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- HACK STALLED
			--------------------------------------------------

			if os.clock()
					- LastProgressTime
					>= self.Config.HackStallRetryTime
			then
				self:_SetStatus(
					"Hack stalled - retrying"
				)

				self:LeaveTrigger()

				Retry =
					true

				break
			end

			--------------------------------------------------
			-- ATTEMPT TIMEOUT
			--------------------------------------------------

			if os.clock()
					- AttemptStarted
					>= self.Config.ComputerAttemptTimeout
			then
				self:_SetStatus(
					"Hack timeout - retrying"
				)

				self:LeaveTrigger()

				Retry =
					true

				break
			end

			task.wait(
				0.05
			)
		end

		--------------------------------------------------
		-- SCREEN GREEN
		--------------------------------------------------

		if self:IsComputerDone(
			Computer
		)
		then
			self:LeaveTrigger()

			self:_SetProgress(
				1
			)

			self:_SetStatus(
				"Computer complete"
			)

			return true
		end

		--------------------------------------------------
		-- CLEAN RETRY
		--------------------------------------------------

		if Retry then
			self:LeaveTrigger()

			task.wait(
				self.Config.HackRetryDelay
			)
		end
	end

	self:LeaveTrigger()

	return self:IsComputerDone(
		Computer
	)
end

--------------------------------------------------
-- EXITS
--------------------------------------------------

function AutoPlay:GetExits()
	local Results = {}

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			table.insert(
				Results,
				Object
			)
		end
	end

	return Results
end

--------------------------------------------------
-- NEAREST EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local BestExit =
		nil

	local BestDistance =
		math.huge

	for _, Exit
		in ipairs(
			self:GetExits()
		)
	do
		local Trigger =
			Exit:FindFirstChild(
				"ExitDoorTrigger",
				true
			)

		if Trigger
			and Trigger:IsA(
				"BasePart"
			)
		then
			local Distance =
				(
					Root.Position
					- Trigger.Position
				).Magnitude

			if Distance < BestDistance then
				BestDistance =
					Distance

				BestExit =
					Exit
			end
		end
	end

	return BestExit
end

--------------------------------------------------
-- USE EXIT
--------------------------------------------------

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Going to exit"
	)

	self:_SetProgress(
		0
	)

	--------------------------------------------------
	-- DOWN -> UNDER EXIT -> UP
	--------------------------------------------------

	local Reached,
		Reason =
		self:SmoothTravelTo(
			Trigger,
			Token,
			false
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	--------------------------------------------------
	-- OPEN EXIT
	--------------------------------------------------

	self:_SetStatus(
		"Opening exit"
	)

	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		--------------------------------------------------
		-- 12 = OPEN EXIT
		--------------------------------------------------

		if ActionSign
			and ActionSign.Value
				~= 12
		then
			break
		end

		if os.clock()
				- Started
				>= self.Config.ExitOpenTimeout
		then
			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	--------------------------------------------------
	-- ESCAPE AREA
	--------------------------------------------------

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Escaped,
		EscapeReason =
		self:SmoothTravelTo(
			ExitArea,
			Token,
			true
		)

	if not Escaped then
		self:_SetStatus(
			"Escape failed: "
				.. tostring(
					EscapeReason
				)
		)

		return false
	end

	self:_SetProgress(
		1
	)

	self:_SetStatus(
		"Escaped"
	)

	return true
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- SURVIVOR ONLY
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- BEAST NEARBY
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		--------------------------------------------------
		-- SCAN COMPUTER SCREENS FIRST
		--------------------------------------------------

		local Computers =
			self:GetComputers()

		if #Computers == 0 then
			self:_SetStatus(
				"Waiting for computers"
			)

			task.wait(
				0.4
			)

			continue
		end

		local Unfinished =
			self:GetUnfinishedComputers()

		--------------------------------------------------
		-- UNFINISHED COMPUTER
		--------------------------------------------------

		if #Unfinished > 0 then
			self:_SetObjective(
				"Computer"
			)

			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				self:_SetStatus(
					"Waiting for free computer"
				)

				task.wait(
					0.25
				)
			end

			continue
		end

		--------------------------------------------------
		-- EVERY COMPUTER SCREEN IS DONE.
		-- GO TO EXIT.
		--------------------------------------------------

		self:LeaveTrigger()

		self:_SetObjective(
			"Exit"
		)

		self:_SetStatus(
			"All computers complete"
		)

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.4
			)

			continue
		end

		--------------------------------------------------
		-- OPEN EXIT + ESCAPE
		--------------------------------------------------

		local Escaped =
			self:UseExit(
				Exit,
				Token
			)

		if Escaped then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.2
		)
	end

	self:CancelTravel()

	self:LeaveTrigger()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		self:CancelTravel()

		self:LeaveTrigger()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		print(
			("[FleeTheFacility] %s %s disabled"):format(
				self.Name,
				self.Version
			)
		)

		return
	end

	print(
		("[FleeTheFacility] %s %s enabled"):format(
			self.Name,
			self.Version
		)
	)

	task.spawn(
		function()
			self:_Run(
				Token
			)
		end
	)
end

