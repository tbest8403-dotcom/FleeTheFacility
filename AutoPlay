--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function ColorsMatch(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(
		A.R - B.R
	) <= Tolerance
		and math.abs(
			A.G - B.G
		) <= Tolerance
		and math.abs(
			A.B - B.B
		) <= Tolerance
end

local function DistanceToSegment(
	Point,
	A,
	B
)
	local AB =
		B - A

	local LengthSquared =
		AB:Dot(
			AB
		)

	if LengthSquared <= 0 then
		return (
			Point - A
		).Magnitude,
			0
	end

	local Alpha =
		(
			Point - A
		):Dot(
			AB
		)
		/ LengthSquared

	Alpha =
		math.clamp(
			Alpha,
			0,
			1
		)

	local Closest =
		A
		+ AB * Alpha

	return (
		Point
		- Closest
	).Magnitude,
		Alpha
end

--------------------------------------------------
-- UI STATUS
--------------------------------------------------

function AutoPlay:_SetStatus(
	Text
)
	if self._statusLabel then
		self._statusLabel:SetText(
			"Status: "
				.. tostring(
					Text
				)
		)
	end
end

function AutoPlay:_SetObjective(
	Text
)
	if self._objectiveLabel then
		self._objectiveLabel:SetText(
			"Objective: "
				.. tostring(
					Text
				)
		)
	end
end

function AutoPlay:_SetProgress(
	Value
)
	Value =
		math.clamp(
			tonumber(Value)
				or 0,
			0,
			1
		)

	if self._progressFill then
		self._progressFill.Size =
			UDim2.fromScale(
				Value,
				1
			)
	end

	if self._progressLabel then
		self._progressLabel.Text =
			("%d%%"):format(
				math.floor(
					Value * 100
				)
			)
	end
end

