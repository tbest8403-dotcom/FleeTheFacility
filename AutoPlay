--------------------------------------------------
-- SKILL CHECK
--------------------------------------------------

function AutoPlay:HandleSkillCheck()
	local Goal =
		tonumber(
			self:GetStatValue(
				"TimingGoalPosition"
			)
		)
		or 0

	if Goal <= 0 then
		self._lastSkillGoal =
			nil

		return
	end

	if self._lastSkillGoal
		== Goal
	then
		return
	end

	self._lastSkillGoal =
		Goal

	pcall(
		function()
			RemoteEvent:FireServer(
				"SetPlayerMinigameResult",
				true
			)
		end
	)
end

