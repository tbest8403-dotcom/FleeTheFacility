function AutoPlay:GetDoorTrigger(
	Door
)
	if not Door then
		return nil
	end

	local Trigger =
		Door:FindFirstChild(
			"DoorTrigger",
			true
		)

	if Trigger
		and Trigger:IsA(
			"BasePart"
		)
	then
		return Trigger
	end

	return nil
end

function AutoPlay:IsDoorOpen(
	Door
)
	local Trigger =
		self:GetDoorTrigger(
			Door
		)

	if not Trigger then
		return true
	end

	local ActionSign =
		Trigger:FindFirstChild(
			"ActionSign"
		)

	if not ActionSign then
		return false
	end

	return ActionSign.Value
		== 11
end

--------------------------------------------------
-- DISTANCE TO ROUTE
--------------------------------------------------

local function DistanceToSegment(
	Point,
	A,
	B
)
	local AB =
		B - A

	local LengthSquared =
		AB:Dot(
			AB
		)

	if LengthSquared <= 0 then
		return (
			Point - A
		).Magnitude,
			0
	end

	local Alpha =
		(
			Point - A
		):Dot(
			AB
		)
		/ LengthSquared

	Alpha =
		math.clamp(
			Alpha,
			0,
			1
		)

	local Closest =
		A
		+ AB * Alpha

	return (
		Point - Closest
	).Magnitude,
		Alpha
end

--------------------------------------------------
-- FIND DOOR
--------------------------------------------------

function AutoPlay:FindDoorOnRoute(
	TargetPosition
)
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestDoor =
		nil

	local BestTrigger =
		nil

	local BestAlpha =
		math.huge

	for _, Door
		in ipairs(
			self:GetDoors()
		)
	do
		if not self:IsDoorOpen(
			Door
		)
		then
			local Trigger =
				self:GetDoorTrigger(
					Door
				)

			if Trigger then
				local Distance,
					Alpha =
					DistanceToSegment(
						Trigger.Position,
						Root.Position,
						TargetPosition
					)

				if Distance
						<= self.Config.DoorRouteDistance
					and Alpha > 0.03
					and Alpha < 0.97
					and Alpha < BestAlpha
				then
					BestDoor =
						Door

					BestTrigger =
						Trigger

					BestAlpha =
						Alpha
				end
			end
		end
	end

	return BestDoor,
		BestTrigger
end

