--------------------------------------------------
-- INIT
--------------------------------------------------

function AutoPlay:Init(
	Navigator
)
	if self._initialized then
		return
	end

	self._initialized =
		true

	self.Navigator =
		Navigator

	print(
		("[FleeTheFacility] %s %s initialized"):format(
			self.Name,
			self.Version
		)
	)
end

--------------------------------------------------
-- UI HELPERS
--------------------------------------------------

function AutoPlay:_SetStatus(
	Text
)
	if self._statusLabel then
		self._statusLabel:SetText(
			"Status: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetObjective(
	Text
)
	if self._objectiveLabel then
		self._objectiveLabel:SetText(
			"Objective: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetProgress(
	Value
)
	Value =
		math.clamp(
			tonumber(Value)
				or 0,
			0,
			1
		)

	if self._progressFill then
		self._progressFill.Size =
			UDim2.fromScale(
				Value,
				1
			)
	end

	if self._progressLabel then
		self._progressLabel.Text =
			("%d%%"):format(
				math.floor(
					Value * 100
				)
			)
	end
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

function AutoPlay:GetCharacter()
	return LocalPlayer.Character
end

function AutoPlay:GetHumanoid()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass(
		"Humanoid"
	)
end

function AutoPlay:GetRoot()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- LOCAL STAT
--------------------------------------------------

function AutoPlay:GetStatValue(
	Name
)
	if not TempPlayerStatsModule
		or type(
			TempPlayerStatsModule.GetValue
		) ~= "function"
	then
		return nil
	end

	local Success,
		Value =
		pcall(
			function()
				return TempPlayerStatsModule.GetValue(
					Name
				)
			end
		)

	if not Success then
		return nil
	end

	return Value
end

function AutoPlay:SetStatValue(
	Name,
	Value
)
	if not TempPlayerStatsModule
		or type(
			TempPlayerStatsModule.SetValue
		) ~= "function"
	then
		return
	end

	pcall(
		function()
			TempPlayerStatsModule.SetValue(
				Name,
				Value
			)
		end
	)
end

--------------------------------------------------
-- OTHER PLAYER STATS
--------------------------------------------------

function AutoPlay:GetStats(
	Player
)
	if not Player then
		return nil
	end

	local ModuleScript =
		Player:FindFirstChild(
			"TempPlayerStatsModule"
		)

	if not ModuleScript then
		return nil
	end

	local Success,
		Module =
		pcall(
			require,
			ModuleScript
		)

	if Success then
		return Module
	end

	return nil
end

--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success,
			Result =
			pcall(
				function()
					return Stats.GetValue(
						"IsBeast"
					)
				end
			)

		if Success then
			return Result == true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

