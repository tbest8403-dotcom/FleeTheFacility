function AutoPlay:IsComputerDone(
	Computer
)
	if not Computer then
		return true
	end

	local Screen =
		Computer:FindFirstChild(
			"Screen"
		)

	if not Screen
		or not Screen:IsA(
			"BasePart"
		)
	then
		return false
	end

	return ColorsMatch(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

