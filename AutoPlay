					)

				Percent.Size =
					UDim2.fromScale(
						1,
						1
					)

				Percent.BackgroundTransparency =
					1

				Percent.Text =
					"0%"

				Percent.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

				Percent.TextSize =
					11

				Percent.Font =
					Enum.Font.GothamBold

				Percent.Parent =
					Bar

				self._progressFill =
					Fill

				self._progressLabel =
					Percent
			end,
	})

	--------------------------------------------------
	-- AUTO PLAY
	--------------------------------------------------

	Section:AddToggle({
		Name =
			"Auto Play",

		Default =
			false,

		Callback =
			function(Value)
				self:SetEnabled(
					Value
				)
			end,
	})

	--------------------------------------------------
	-- SPEED
	--------------------------------------------------

	Section:AddSlider({
		Name =
			"Tween Speed",

		Min =
			10,

		Max =
			80,

		Default =
			self.Config.MoveSpeed,

		Increment =
			1,

		Callback =
			function(Value)
				self.Config.MoveSpeed =
					Value
			end,
	})

	--------------------------------------------------
	-- BEAST RANGE
	--------------------------------------------------

	Section:AddSlider({
		Name =
			"Beast Avoid Distance",

		Min =
			20,

		Max =
			120,

		Default =
			self.Config.BeastAvoidDistance,

		Increment =
			5,

		Callback =
			function(Value)
				self.Config.BeastAvoidDistance =
					Value

				if self.Config.BeastResumeDistance
					<= Value
				then
					self.Config.BeastResumeDistance =
						Value + 20
				end
			end,
	})

	--------------------------------------------------
	-- HIDE DEPTH
	--------------------------------------------------

	Section:AddSlider({
		Name =
			"Hide Depth",

		Min =
			5,

		Max =
			40,

		Default =
			self.Config.HideDepth,

		Increment =
			1,

		Callback =
			function(Value)
				self.Config.HideDepth =
					Value
			end,
	})

	--------------------------------------------------
	-- SKILL CHECK
	--------------------------------------------------

	Section:AddToggle({
		Name =
			"Admin Skill Check",

		Default =
			self.Config.AutoSkillCheck,

		Callback =
			function(Value)
				self.Config.AutoSkillCheck =
					Value
			end,
	})
end

--------------------------------------------------
-- STOP
--------------------------------------------------

function AutoPlay:Stop()
	self.Config.Enabled =
		false

	self._runToken += 1

	self:CancelTween()

	self:StopInteraction()

	self:_SetStatus(
		"Stopped"
	)

	self:_SetObjective(
		"None"
	)
end

function AutoPlay:Destroy()
	self:Stop()
end

return AutoPlay
