--------------------------------------------------
-- STOP
--------------------------------------------------

function AutoPlay:Stop()
	self.Config.Enabled =
		false

	self._runToken += 1

	self:CancelTween()

	self:StopInteraction()

	self:_SetStatus(
		"Stopped"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)
end

function AutoPlay:Destroy()
	self:Stop()
end

return AutoPlay
