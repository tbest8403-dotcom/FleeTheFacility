function AutoPlay:CancelMove()
	self._moveGeneration += 1

	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if Humanoid
		and Root
	then
		Humanoid:MoveTo(
			Root.Position
		)
	end
end

--------------------------------------------------
-- MOVEMENT STATE
--------------------------------------------------

function AutoPlay:_CheckMoveState(
	Token,
	Generation,
	Options
)
	if not self.Config.Enabled
		or Token
			~= self._runToken
		or Generation
			~= self._moveGeneration
	then
		return false,
			"Stopped"
	end

	if not Options.IgnoreThreat
		and self:IsBeastClose()
	then
		return false,
			"Threat"
	end

	if Options.Computer
		and self:IsComputerDone(
			Options.Computer
		)
	then
		return false,
			"Completed"
	end

	if Options.Trigger then
		local Occupied =
			self:IsTriggerOccupied(
				Options.Trigger
			)

		if Occupied then
			return false,
				"Occupied"
		end
	end

	return true
end

--------------------------------------------------
-- FOLLOW WAYPOINT
--------------------------------------------------

function AutoPlay:_FollowWaypoint(
	Waypoint,
	Token,
	Generation,
	Options
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	if Waypoint.Action
		== Enum.PathWaypointAction.Jump
	then
		Humanoid.Jump =
			true
	end

	Humanoid:MoveTo(
		Waypoint.Position
	)

	local Started =
		os.clock()

	while true do
		local Valid,
			Reason =
			self:_CheckMoveState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		if (
			Root.Position
			- Waypoint.Position
		).Magnitude
			<= self.Config.WaypointArrivalDistance
		then
			return true
		end

		if os.clock()
			- Started
			>= self.Config.WaypointTimeout
		then
			return false,
				"Blocked"
		end

		task.wait(
			0.03
		)
	end
end

--------------------------------------------------
-- WALK DIRECT
--------------------------------------------------

function AutoPlay:_WalkDirect(
	TargetPosition,
	Token,
	Generation,
	Options
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	Humanoid:MoveTo(
		TargetPosition
	)

	local Started =
		os.clock()

	while (
		Root.Position
		- TargetPosition
	).Magnitude
		> self.Config.FinalArrivalDistance
	do
		local Valid,
			Reason =
			self:_CheckMoveState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		if os.clock()
			- Started
			>= self.Config.WaypointTimeout
		then
			return false,
				"Blocked"
		end

		task.wait(
			0.03
		)
	end

	return true,
		"Reached"
end

--------------------------------------------------
-- OPEN DOOR
--------------------------------------------------

function AutoPlay:OpenDoor(
	Door,
	Trigger,
	Token,
	Generation
)
	if not Door
		or not Trigger
	then
		return false
	end

	if self:IsDoorOpen(
		Door
	)
	then
		return true
	end

	self:_SetStatus(
		"Opening door"
	)

	--------------------------------------------------
	-- GET TO DOOR TRIGGER
	--------------------------------------------------

	local Path =
		self:CreatePath(
			self:GetRoot().Position,
			Trigger.Position
		)

	if Path then
		for _, Waypoint
			in ipairs(
				Path:GetWaypoints()
			)
		do
			local Success,
				Reason =
				self:_FollowWaypoint(
					Waypoint,
					Token,
					Generation,
					{
						IgnoreThreat =
							false,
					}
				)

			if not Success then
				return false,
					Reason
			end
		end
	else
		local Success,
			Reason =
			self:_WalkDirect(
				Trigger.Position,
				Token,
				Generation,
				{
					IgnoreThreat =
						false,
				}
			)

		if not Success then
			return false,
				Reason
		end
	end

	--------------------------------------------------
	-- OPEN
	--------------------------------------------------

	self:PulseAction(
		Trigger
	)

	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.DoorOpenTimeout
	do
		if self:IsDoorOpen(
			Door
		)
		then
			return true
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return self:IsDoorOpen(
		Door
	)
end

--------------------------------------------------
-- MOVE TO OBJECTIVE
--------------------------------------------------

function AutoPlay:MoveTo(
	TargetCFrame,
	Token,
	Options
)
	Options =
		Options
		or {}

	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	--------------------------------------------------
	-- USES CURRENT HUMANOID.WALKSPEED
	--------------------------------------------------

	self:CancelMove()

	local Generation =
		self._moveGeneration

	local TargetPosition =
		TargetCFrame.Position

	for Attempt = 1,
		self.Config.PathRetries
	do
		local Valid,
			Reason =
			self:_CheckMoveState(
				Token,
				Generation,
				Options
			)

		if not Valid then
			return false,
				Reason
		end

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		--------------------------------------------------
		-- CHECK FOR CLOSED SINGLEDOOR
		--------------------------------------------------

		local Door,
			DoorTrigger =
			self:FindDoorOnRoute(
				Root.Position,
				TargetPosition
			)

		if Door
			and DoorTrigger
		then
			local Opened,
				DoorReason =
				self:OpenDoor(
					Door,
					DoorTrigger,
					Token,
					Generation
				)

			if not Opened then
				if DoorReason
					and DoorReason
						~= "Blocked"
				then
					return false,
						DoorReason
				end
			end

			task.wait(
				0.08
			)
		end

		--------------------------------------------------
		-- CREATE PATH
		--------------------------------------------------

		local Path =
			self:CreatePath(
				Root.Position,
				TargetPosition
			)

		if not Path then
			local Direct,
				DirectReason =
				self:_WalkDirect(
					TargetPosition,
					Token,
					Generation,
					Options
				)

			if Direct then
				return true,
					"Reached"
			end

			if DirectReason
				~= "Blocked"
			then
				return false,
					DirectReason
			end

			continue
		end

		--------------------------------------------------
		-- FOLLOW
		--------------------------------------------------

		local FailedReason =
			nil

		for _, Waypoint
			in ipairs(
				Path:GetWaypoints()
			)
		do
			local Success,
				WaypointReason =
				self:_FollowWaypoint(
					Waypoint,
					Token,
					Generation,
					Options
				)

			if not Success then
				FailedReason =
					WaypointReason

				break
			end
		end

		if not FailedReason then
			local FinalSuccess,
				FinalReason =
				self:_WalkDirect(
					TargetPosition,
					Token,
					Generation,
					Options
				)

			if FinalSuccess then
				return true,
					"Reached"
			end

			FailedReason =
				FinalReason
		end

		if FailedReason
			and FailedReason
				~= "Blocked"
		then
			return false,
				FailedReason
		end
	end

	return false,
		"Blocked"
end

--------------------------------------------------
-- BEAST HIDE
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	self:CancelMove()

	self:LeaveTrigger()

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Humanoid.AutoRotate =
		false

	Root.Anchored =
		true

	--------------------------------------------------
	-- TWEEN BELOW
	--------------------------------------------------

	local DownTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					HiddenCFrame,
			}
		)

	DownTween:Play()

	DownTween.Completed:Wait()

	--------------------------------------------------
	-- WAIT UNTIL BEAST LEAVES
	--------------------------------------------------

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not Root.Parent then
		return false
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			OriginalAnchored

		Humanoid.AutoRotate =
			OriginalAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	--------------------------------------------------
	-- TWEEN BACK
	--------------------------------------------------

	local UpTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					ReturnCFrame,
			}
		)

	UpTween:Play()

	UpTween.Completed:Wait()

	Root.Anchored =
		OriginalAnchored

	Humanoid.AutoRotate =
		OriginalAutoRotate

	return true
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Walking to computer"
	)

	local Arrived,
		Reason =
		self:MoveTo(
			CFrame.new(
				Trigger.Position
			),
			Token,
			{
				Computer =
					Computer,

				Trigger =
					Trigger,
			}
		)

	if not Arrived then
		if Reason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	--------------------------------------------------
	-- RECHECK
	--------------------------------------------------

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	if self:IsBeastClose() then
		self:HideFromBeast(
			Token
		)

		return false
	end

	--------------------------------------------------
	-- HACK
	--------------------------------------------------

	self:_SetStatus(
		"Hacking"
	)

	if not self:StartAction(
		Trigger
	)
	then
		return false
	end

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsComputerDone(
			Computer
		)
		then
			self:_SetProgress(
				1
			)

			break
		end

		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	if self:IsComputerDone(
		Computer
	)
	then
		self:_SetStatus(
			"Computer complete"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local BestExit = nil

	local BestDistance =
		math.huge

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			local Trigger =
				Object:FindFirstChild(
					"ExitDoorTrigger",
					true
				)

			if Trigger
				and Trigger:IsA(
					"BasePart"
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestExit =
						Object
				end
			end
		end
	end

	return BestExit
end

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Walking to exit"
	)

	local Arrived,
		Reason =
		self:MoveTo(
			CFrame.new(
				Trigger.Position
			),
			Token,
			{}
		)

	if not Arrived then
		if Reason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	self:_SetStatus(
		"Opening exit"
	)

	--------------------------------------------------
	-- HOLD EXIT ACTION
	--------------------------------------------------

	self:StartAction(
		Trigger
	)

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		if ActionSign
			and ActionSign.Value
				~= 12
		then
			break
		end

		if os.clock()
			- Started
			>= self.Config.ExitOpenTimeout
		then
			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	--------------------------------------------------
	-- EXIT AREA
	--------------------------------------------------

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Escaped =
		self:MoveTo(
			CFrame.new(
				ExitArea.Position
			),
			Token,
			{
				IgnoreThreat =
					true,
			}
		)

	if Escaped then
		self:_SetStatus(
			"Escaped"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- DON'T RUN SURVIVOR AUTOPLAY AS BEAST
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- BEAST WITHIN 15 STUDS
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		--------------------------------------------------
		-- COMPUTERS
		--------------------------------------------------

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				self:_SetStatus(
					"Waiting for free computer"
				)

				task.wait(
					0.25
				)
			end

			continue
		end

		--------------------------------------------------
		-- EXIT
		--------------------------------------------------

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		if self:UseExit(
			Exit,
			Token
		)
		then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.2
		)
	end

	self:CancelMove()

	self:LeaveTrigger()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		self:CancelMove()

		self:LeaveTrigger()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		return
	end

	task.spawn(function()
		self:_Run(
			Token
		)
	end)
end

