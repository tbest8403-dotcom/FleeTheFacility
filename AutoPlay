-- NAVIGATION
--------------------------------------------------

function AutoPlay:NavigateTo(
	Target,
	Token,
	Options
)
	if not self.Navigator then
		return false,
			"NoNavigator"
	end

	Options =
		Options or {}

	return self.Navigator:MoveTo(
		Target,
		{
			ProjectToGround =
				Options.ProjectToGround,

			ShouldAbort =
				function()
					if not self.Config.Enabled
						or Token
							~= self._runToken
					then
						return "Stopped"
					end

					if not Options.IgnoreBeast
						and self:IsBeastClose()
					then
						return "Threat"
					end

					if Options.Computer
						and self:IsComputerDone(
							Options.Computer
						)
					then
						return "Completed"
					end

					if Options.Trigger then
						local Occupied =
							self:IsTriggerOccupied(
								Options.Trigger
							)

						if Occupied then
							return "Occupied"
						end
					end

					return nil
				end,
		}
	)
end

--------------------------------------------------
-- OPEN DOOR
--------------------------------------------------

function AutoPlay:OpenDoor(
	Door,
	Trigger,
	Token
)
	if not Door
		or not Trigger
	then
		return false
	end

	if self:IsDoorOpen(
		Door
	)
	then
		return true
	end

	self:_SetStatus(
		"Opening door"
	)

	local Reached,
		Reason =
		self:NavigateTo(
			Trigger,
			Token,
			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		return false,
			Reason
	end

	local Settled,
		SettleReason =
		self:SettleIntoTrigger(
			Trigger,
			Token
		)

	if not Settled then
		return false,
			SettleReason
	end

	if not self:PulseAction(
		Trigger,
		Token,
		0.14
	)
	then
		return false
	end

	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.DoorOpenTimeout
	do
		if self:IsDoorOpen(
			Door
		)
		then
			return true
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return self:IsDoorOpen(
		Door
	)
end

--------------------------------------------------
-- NAVIGATE WITH DOORS
--------------------------------------------------

function AutoPlay:NavigateWithDoors(
	Target,
	Token,
	Options
)
	Options =
		Options or {}

	local TargetPosition

	if typeof(Target)
		== "Vector3"
	then
		TargetPosition =
			Target

	elseif typeof(Target)
		== "CFrame"
	then
		TargetPosition =
			Target.Position

	elseif typeof(Target)
			== "Instance"
		and Target:IsA(
			"BasePart"
		)
	then
		TargetPosition =
			Target.Position

	else
		return false,
			"InvalidTarget"
	end

	local Door,
		DoorTrigger =
		self:FindDoorOnRoute(
			TargetPosition
		)

	if Door
		and DoorTrigger
	then
		local Opened,
			Reason =
			self:OpenDoor(
				Door,
				DoorTrigger,
				Token
			)

		if not Opened
			and Reason == "Threat"
		then
			return false,
				Reason
		end
	end

	local Reached,
		Reason =
		self:NavigateTo(
			Target,
			Token,
			Options
		)

	if not Reached
		and (
			Reason == "Blocked"
			or Reason == "Repath"
		)
	then
		Door,
			DoorTrigger =
			self:FindDoorOnRoute(
				TargetPosition
			)

		if Door
			and DoorTrigger
		then
			self:OpenDoor(
				Door,
				DoorTrigger,
				Token
			)

			return self:NavigateTo(
				Target,
				Token,
				Options
			)
		end
	end

	return Reached,
		Reason
end

--------------------------------------------------
-- BEAST HIDE
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Humanoid.AutoRotate =
		false

	Root.Anchored =
		true

	local DownTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					HiddenCFrame,
			}
		)

	DownTween:Play()

	DownTween.Completed:Wait()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not Root.Parent then
		return false
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			OriginalAnchored

		Humanoid.AutoRotate =
			OriginalAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	local UpTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					ReturnCFrame,
			}
		)

	UpTween:Play()

	UpTween.Completed:Wait()

	Root.Anchored =
		OriginalAnchored

	Humanoid.AutoRotate =
		OriginalAutoRotate

	self:LeaveTrigger()

	task.wait(
		0.08
	)

	return true
end

--------------------------------------------------
-- RESTART COMPUTER ACTION
--------------------------------------------------

function AutoPlay:RestartComputerAction(
	Computer,
	Trigger,
	Token,
	Status
)
	self:_SetStatus(
		Status or "Retrying hack"
	)

	self:LeaveTrigger()

	task.wait(
		self.Config.HackRetryDelay
	)

	if self:IsBeastClose() then
		return false,
			"Threat"
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true,
			"Completed"
	end

	if self:IsComputerError(
		Computer
	)
	then
		local Cleared,
			Reason =
			self:WaitForComputerErrorClear(
				Computer,
				Token
			)

		if not Cleared then
			return false,
				Reason
		end

		task.wait(
			self.Config.ErrorRetryDelay
		)
	end

	local Settled,
		Reason =
		self:SettleIntoTrigger(
			Trigger,
			Token
		)

	if not Settled then
		return false,
			Reason
	end

	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false,
			"ActionFailed"
	end

	return true,
		"Started"
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Going to computer"
	)

	--------------------------------------------------
	-- NAVIGATOR GETS US NEAR IT
	--------------------------------------------------

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,
			Token,
			{
				Computer =
					Computer,

				Trigger =
					Trigger,

				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	--------------------------------------------------
	-- KEEP THIS SAME COMPUTER UNTIL IT'S DONE
	--------------------------------------------------

	while self.Config.Enabled
		and Token
			== self._runToken
		and not self:IsComputerDone(
			Computer
		)
	do
		--------------------------------------------------
		-- BEAST
		--------------------------------------------------

		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		--------------------------------------------------
		-- SOMEONE TOOK THIS SPOT
		--------------------------------------------------

		if self:IsTriggerOccupied(
			Trigger
		)
		then
			self:LeaveTrigger()

			return false
		end

		--------------------------------------------------
		-- MOVE MUCH CLOSER
		--------------------------------------------------

		self:_SetStatus(
			"Positioning"
		)

		local Settled,
			SettleReason =
			self:SettleIntoTrigger(
				Trigger,
				Token
			)

		if not Settled then
			if SettleReason
				== "Threat"
			then
				self:HideFromBeast(
					Token
				)

				return false
			end

			--------------------------------------------------
			-- TRY NAVIGATION AGAIN
			--------------------------------------------------

			self:_SetStatus(
				"Repositioning"
			)

			self:NavigateWithDoors(
				Trigger,
				Token,
				{
					Computer =
						Computer,

					Trigger =
						Trigger,

					ProjectToGround =
						true,
				}
			)

			task.wait(
				0.1
			)

			continue
		end

		--------------------------------------------------
		-- ERROR BEFORE START?
		--------------------------------------------------

		if self:IsComputerError(
			Computer
		)
		then
			self:_SetStatus(
				"Computer error - recovering"
			)

			self:LeaveTrigger()

			local Cleared,
				ErrorReason =
				self:WaitForComputerErrorClear(
					Computer,
					Token
				)

			if not Cleared
				and ErrorReason
					== "Threat"
			then
				self:HideFromBeast(
					Token
				)

				return false
			end

			task.wait(
				self.Config.ErrorRetryDelay
			)
		end

		--------------------------------------------------
		-- START HACK
		--------------------------------------------------

		self:_SetStatus(
			"Hacking"
		)

		if not self:StartAction(
			Trigger,
			Token
		)
		then
			task.wait(
				self.Config.HackRetryDelay
			)

			continue
		end

		local AttemptStarted =
			os.clock()

		local LastProgress =
			self:GetActionProgress()

		local LastProgressTime =
			os.clock()

		local RetryHack =
			false

		--------------------------------------------------
		-- CURRENT HACK ATTEMPT
		--------------------------------------------------

		while self.Config.Enabled
			and Token
				== self._runToken
			and not self:IsComputerDone(
				Computer
			)
		do
			--------------------------------------------------
			-- BEAST
			--------------------------------------------------

			if self:IsBeastClose() then
				self:LeaveTrigger()

				self:HideFromBeast(
					Token
				)

				return false
			end

			--------------------------------------------------
			-- ERROR SCREEN
			--------------------------------------------------

			if self:IsComputerError(
				Computer
			)
			then
				self:_SetStatus(
					"Computer error - retrying"
				)

				self:LeaveTrigger()

				self:WaitForComputerErrorClear(
					Computer,
					Token
				)

				task.wait(
					self.Config.ErrorRetryDelay
				)

				RetryHack =
					true

				break
			end

			--------------------------------------------------
			-- SKILL CHECK
			--------------------------------------------------

			self:HandleSkillCheck()

			--------------------------------------------------
			-- PROGRESS
			--------------------------------------------------

			local Progress =
				self:GetActionProgress()

			self:_SetProgress(
				Progress
			)

			if Progress
				> LastProgress
					+ self.Config.HackProgressEpsilon
			then
				LastProgress =
					Progress

				LastProgressTime =
					os.clock()
			end

			--------------------------------------------------
			-- LOST TRIGGER
			--------------------------------------------------

			local OnTrigger =
				self:GetStatValue(
					"OnTrigger"
				)

			if OnTrigger == false then
				self:_SetStatus(
					"Lost trigger - retrying"
				)

				self:LeaveTrigger()

				RetryHack =
					true

				break
			end

			--------------------------------------------------
			-- PROGRESS STALLED
			--------------------------------------------------

			if os.clock()
					- LastProgressTime
					>= self.Config.HackStallRetryTime
			then
				self:_SetStatus(
					"Hack stalled - retrying"
				)

				self:LeaveTrigger()

				task.wait(
					self.Config.HackRetryDelay
				)

				RetryHack =
					true

				break
			end

			--------------------------------------------------
			-- ATTEMPT TIMEOUT
			--------------------------------------------------

			if os.clock()
					- AttemptStarted
					>= self.Config.ComputerTimeout
			then
				self:_SetStatus(
					"Hack timeout - retrying"
				)

				self:LeaveTrigger()

				task.wait(
					self.Config.HackRetryDelay
				)

				RetryHack =
					true

				break
			end

			task.wait(
				0.05
			)
		end

		--------------------------------------------------
		-- FINISHED
		--------------------------------------------------

		if self:IsComputerDone(
			Computer
		)
		then
			self:LeaveTrigger()

			self:_SetProgress(
				1
			)

			self:_SetStatus(
				"Computer complete"
			)

			return true
		end

		--------------------------------------------------
		-- CLEAN RETRY
		--------------------------------------------------

		if RetryHack then
			self:LeaveTrigger()

			task.wait(
				self.Config.HackRetryDelay
			)

			continue
		end
	end

	self:LeaveTrigger()

	return self:IsComputerDone(
		Computer
	)
end

--------------------------------------------------
-- EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local BestExit =
		nil

	local BestDistance =
		math.huge

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			local Trigger =
				Object:FindFirstChild(
					"ExitDoorTrigger",
					true
				)

			if Trigger
				and Trigger:IsA(
					"BasePart"
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance < BestDistance then
					BestDistance =
						Distance

					BestExit =
						Object
				end
			end
		end
	end

	return BestExit
end

--------------------------------------------------
-- USE EXIT
--------------------------------------------------

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Going to exit"
	)

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,
			Token,
			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	local Settled,
		SettleReason =
		self:SettleIntoTrigger(
			Trigger,
			Token
		)

	if not Settled then
		if SettleReason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	self:_SetStatus(
		"Opening exit"
	)

	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		if ActionSign
			and ActionSign.Value
				~= 12
		then
			break
		end

		if os.clock()
			- Started
			>= self.Config.ExitOpenTimeout
		then
			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Escaped =
		self:NavigateWithDoors(
			ExitArea,
			Token,
			{
				IgnoreBeast =
					true,

				ProjectToGround =
					true,
			}
		)

	if not Escaped then
		return false
	end

	self:_SetStatus(
		"Escaped"
	)

	return true
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- BEAST PLAYER
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- BEAST NEARBY
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		--------------------------------------------------
		-- COMPUTERS
		--------------------------------------------------

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				self:_SetStatus(
					"Waiting for free computer"
				)

				task.wait(
					0.25
				)
			end

			continue
		end

		--------------------------------------------------
		-- EXIT
		--------------------------------------------------

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		local Escaped =
			self:UseExit(
				Exit,
				Token
			)

		if Escaped then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.2
		)
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		if self.Navigator then
			self.Navigator:Cancel()
		end

		self:LeaveTrigger()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		print(
			("[FleeTheFacility] %s %s disabled"):format(
				self.Name,
				self.Version
			)
		)

		return
	end

	print(
		("[FleeTheFacility] %s %s enabled"):format(
			self.Name,
			self.Version
		)
	)

	task.spawn(
		function()
			self:_Run(
				Token
			)
		end
	)
end

