--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success,
			Result =
			pcall(
				function()
					return Stats.GetValue(
						"IsBeast"
					)
				end
			)

		if Success then
			return Result == true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player in ipairs(
		Players:GetPlayers()
	) do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- LEAVE TRIGGER
--------------------------------------------------

function AutoPlay:LeaveTrigger()
	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				false
			)
		end
	)

	self:SetStatValue(
		"ActionInput",
		false
	)

	local Trigger =
		self._currentTrigger

	if Trigger
		and Trigger.Parent
	then
		local Event =
			Trigger:FindFirstChild(
				"Event"
			)

		if Event then
			pcall(
				function()
					RemoteEvent:FireServer(
						"Input",
						"Trigger",
						false,
						Event
					)
				end
			)
		end
	end

	self._currentTrigger =
		nil

	self._lastSkillGoal =
		nil
end

--------------------------------------------------
-- TRIGGER CONFIRM
--------------------------------------------------

function AutoPlay:WaitForTriggerConfirmation(
	Token
)
	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.TriggerConfirmTimeout
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false
		end

		local OnTrigger =
			self:GetStatValue(
				"OnTrigger"
			)

		if OnTrigger == true then
			return true
		end

		if OnTrigger == nil
			and os.clock()
				- Started
				>= self.Config.TriggerSettleTime
		then
			return true
		end

		task.wait(
			0.025
		)
	end

	return true
end

--------------------------------------------------
-- ENTER TRIGGER
--------------------------------------------------

function AutoPlay:EnterTrigger(
	Trigger,
	Token
)
	if not Trigger
		or not Trigger.Parent
	then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	if self._currentTrigger
		and self._currentTrigger
			~= Trigger
	then
		self:LeaveTrigger()
	end

	self._currentTrigger =
		Trigger

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Trigger",
				true,
				Event
			)
		end
	)

	self:WaitForTriggerConfirmation(
		Token
	)

	task.wait(
		self.Config.TriggerSettleTime
	)

	return true
end

--------------------------------------------------
-- START ACTION
--------------------------------------------------

function AutoPlay:StartAction(
	Trigger,
	Token
)
	if not self:EnterTrigger(
		Trigger,
		Token
	)
	then
		return false
	end

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				true
			)
		end
	)

	self:SetStatValue(
		"ActionInput",
		true
	)

	task.wait(
		self.Config.ActionSettleTime
	)

	return true
end

--------------------------------------------------
-- PULSE
--------------------------------------------------

function AutoPlay:PulseAction(
	Trigger,
	Token,
	HoldTime
)
	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false
	end

	task.wait(
		HoldTime or 0.14
	)

	self:LeaveTrigger()

	return true
end

