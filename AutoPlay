	)
end

--------------------------------------------------
-- STATS
--------------------------------------------------

function AutoPlay:GetStats(
	Player
)
	if not Player then
		return nil
	end

	local ModuleScript =
		Player:FindFirstChild(
			"TempPlayerStatsModule"
		)

	if not ModuleScript then
		return nil
