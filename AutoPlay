--------------------------------------------------
-- COMPUTER
--------------------------------------------------

function AutoPlay:IsComputerDone(
	Computer
)
	if not Computer then
		return true
	end

	local Screen =
		Computer:FindFirstChild(
			"Screen"
		)

	if not Screen
		or not Screen:IsA(
			"BasePart"
		)
	then
		return false
	end

	return ColorsMatch(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

function AutoPlay:GetComputers()
	local Computers = {}

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ComputerTable"
		then
			table.insert(
				Computers,
				Object
			)
		end
	end

	return Computers
end

function AutoPlay:GetComputerTriggers(
	Computer
)
	local Triggers = {}

	if not Computer then
		return Triggers
	end

	for Index = 1, 3 do
		local Trigger =
			Computer:FindFirstChild(
				"ComputerTrigger"
					.. Index,
				true
			)

		if Trigger
			and Trigger:IsA(
				"BasePart"
			)
		then
			local ActionSign =
				Trigger:FindFirstChild(
					"ActionSign"
				)

			local Event =
				Trigger:FindFirstChild(
					"Event"
				)

			if ActionSign
				and Event
				and ActionSign.Value
					== 20
			then
				table.insert(
					Triggers,
					Trigger
				)
			end
		end
	end

	return Triggers
end

--------------------------------------------------
-- OCCUPANCY
--------------------------------------------------

function AutoPlay:IsTriggerOccupied(
	Trigger
)
	if not Trigger then
		return true
	end

	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer then
			local Character =
				Player.Character

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if Root
				and (
					not Humanoid
					or Humanoid.Health > 0
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					<= self.Config.TriggerOccupancyRadius
				then
					return true,
						Player
				end
			end
		end
	end

	return false,
		nil
end

function AutoPlay:GetAvailableTriggers(
	Computer
)
	local Available = {}

	for _, Trigger
		in ipairs(
			self:GetComputerTriggers(
				Computer
			)
		)
	do
		local Occupied =
			self:IsTriggerOccupied(
				Trigger
			)

		if not Occupied then
			table.insert(
				Available,
				Trigger
			)
		end
	end

	return Available
end

--------------------------------------------------
-- COMPUTER TARGET
--------------------------------------------------

function AutoPlay:GetNearestComputerTarget()
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestComputer = nil

	local BestTrigger = nil

	local BestDistance =
		math.huge

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		if not self:IsComputerDone(
			Computer
		)
		then
			for _, Trigger
				in ipairs(
					self:GetAvailableTriggers(
						Computer
					)
				)
			do
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestComputer =
						Computer

					BestTrigger =
						Trigger
				end
			end
		end
	end

	return BestComputer,
		BestTrigger
end

function AutoPlay:AreComputersDone()
	local Found =
		false

	for _, Computer
		in ipairs(
			self:GetComputers()
		)
	do
		Found =
			true

		if not self:IsComputerDone(
			Computer
		)
		then
			return false
		end
	end

	return Found
end

