function AutoPlay:GetCharacter()
	return LocalPlayer.Character
end

function AutoPlay:GetHumanoid()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass(
		"Humanoid"
	)
end

function AutoPlay:GetRoot()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- PLAYER STATS
--------------------------------------------------

function AutoPlay:GetStats(
	Player
)
	if not Player then
		return nil
	end

	local ModuleScript =
		Player:FindFirstChild(
			"TempPlayerStatsModule"
		)

	if not ModuleScript then
		return nil
	end

	local Success, Module =
		pcall(
			require,
			ModuleScript
		)

	if Success then
		return Module
	end

	return nil
end

--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success, Result =
			pcall(function()
				return Stats.GetValue(
					"IsBeast"
				)
			end)

		if Success
			and Result == true
		then
			return true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- INTERACTION
--------------------------------------------------

function AutoPlay:LeaveTrigger()
	RemoteEvent:FireServer(
		"Input",
		"Action",
		false
	)

	if self._currentTrigger then
		local Event =
			self._currentTrigger:FindFirstChild(
				"Event"
			)

		if Event then
			RemoteEvent:FireServer(
				"Input",
				"Trigger",
				false,
				Event
			)
		end
	end

	self._currentTrigger =
		nil
end

function AutoPlay:EnterTrigger(
	Trigger
)
	if not Trigger then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	if self._currentTrigger
		and self._currentTrigger
			~= Trigger
	then
		self:LeaveTrigger()
	end

	self._currentTrigger =
		Trigger

	RemoteEvent:FireServer(
		"Input",
		"Trigger",
		true,
		Event
	)

	task.wait(
		0.08
	)

	return true
end

function AutoPlay:StartAction(
	Trigger
)
	if not self:EnterTrigger(
		Trigger
	)
	then
		return false
	end

	RemoteEvent:FireServer(
		"Input",
		"Action",
		true
	)

	return true
end

function AutoPlay:PulseAction(
	Trigger
)
	if not self:StartAction(
		Trigger
	)
	then
		return false
	end

	task.wait(
		0.12
	)

	self:LeaveTrigger()

	return true
end

