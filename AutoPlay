--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success, Result =
			pcall(
				function()
					return Stats.GetValue(
						"IsBeast"
					)
				end
			)

		if Success then
			return Result
				== true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player
				~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- REMOTE INTERACTION
--------------------------------------------------

function AutoPlay:LeaveTrigger()
	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				false
			)
		end
	)

	local Trigger =
		self._currentTrigger

	if Trigger
		and Trigger.Parent
	then
		local Event =
			Trigger:FindFirstChild(
				"Event"
			)

		if Event then
			pcall(
				function()
					RemoteEvent:FireServer(
						"Input",
						"Trigger",
						false,
						Event
					)
				end
			)
		end
	end

	self._currentTrigger =
		nil
end

--------------------------------------------------
-- ENTER TRIGGER
--------------------------------------------------

function AutoPlay:EnterTrigger(
	Trigger
)
	if not Trigger
		or not Trigger.Parent
	then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	if self._currentTrigger
		and self._currentTrigger
			~= Trigger
	then
		self:LeaveTrigger()
	end

	self._currentTrigger =
		Trigger

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Trigger",
				true,
				Event
			)
		end
	)

	task.wait(
		0.08
	)

	return true
end

--------------------------------------------------
-- START ACTION
--------------------------------------------------

function AutoPlay:StartAction(
	Trigger
)
	if not self:EnterTrigger(
		Trigger
	)
	then
		return false
	end

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				true
			)
		end
	)

	return true
end

--------------------------------------------------
-- PULSE ACTION
--------------------------------------------------

function AutoPlay:PulseAction(
	Trigger,
	Time
)
	if not self:StartAction(
		Trigger
	)
	then
		return false
	end

	task.wait(
		Time or 0.14
	)

	self:LeaveTrigger()

	return true
end

