function AutoPlay:GetNearestExit()
	if not self.Navigator then
		return nil
	end

	local BestExit = nil

	local BestDistance =
		math.huge

	for _, Object in ipairs(
		Workspace:GetDescendants()
	) do
		if Object.Name
			== "ExitDoor"
		then
			local Trigger =
				Object:FindFirstChild(
					"ExitDoorTrigger",
					true
				)

			if Trigger
				and Trigger:IsA(
					"BasePart"
				)
			then
				local Distance =
					self.Navigator:GetPathDistance(
						Trigger,

						{
							ProjectToGround =
								true,
						}
					)

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestExit =
						Object
				end
			end
		end
	end

	return BestExit
end

--------------------------------------------------
-- USE EXIT
--------------------------------------------------

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Going to exit"
	)

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,

			Token,

			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason == "Threat" then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	local Settled,
		SettleReason =
		self:SettleIntoTrigger(
			Trigger,
			Token,
			nil
		)

	if not Settled then
		if SettleReason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	self:_SetStatus(
		"Opening exit"
	)

	if not self:StartAction(
		Trigger,
		Token
	)
	then
		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		if ActionSign
			and ActionSign.Value
				~= 12
		then
			break
		end

		if os.clock()
			- Started
			>= self.Config.ExitOpenTimeout
		then
			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Escaped =
		self:NavigateWithDoors(
			ExitArea,

			Token,

			{
				IgnoreBeast =
					true,

				ProjectToGround =
					true,
			}
		)

	if Escaped then
		self:_SetStatus(
			"Escaped"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		--------------------------------------------------
		-- LOCAL PLAYER IS BEAST
		--------------------------------------------------

		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- BEAST TOO CLOSE
		--------------------------------------------------

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		--------------------------------------------------
		-- COMPUTERS
		--------------------------------------------------

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				--------------------------------------------------
				-- COMPUTERS MAY CURRENTLY BE UNREACHABLE
				--------------------------------------------------

				self:_SetStatus(
					"Searching for reachable computer"
				)

				task.wait(
					0.35
				)
			end

			continue
		end

		--------------------------------------------------
		-- EXIT
		--------------------------------------------------

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		if self:UseExit(
			Exit,
			Token
		)
		then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.2
		)
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		if self.Navigator then
			self.Navigator:Cancel()
		end

		self:LeaveTrigger()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		print(
			("[FleeTheFacility] %s %s disabled"):format(
				self.Name,
				self.Version
			)
		)

		return
	end

	print(
		("[FleeTheFacility] %s %s enabled"):format(
			self.Name,
			self.Version
		)
	)

	task.spawn(
		function()
			self:_Run(
				Token
			)
		end
	)
end

