--------------------------------------------------
-- TRIGGERS
--------------------------------------------------

function AutoPlay:GetComputerTriggers(
	Computer
)
	local Results = {}

	if not Computer then
		return Results
	end

	for Index = 1, 3 do
		local Trigger =
			Computer:FindFirstChild(
				"ComputerTrigger"
					.. Index,

				true
			)

		if Trigger
			and Trigger:IsA(
				"BasePart"
			)
		then
			local ActionSign =
				Trigger:FindFirstChild(
					"ActionSign"
				)

			local Event =
				Trigger:FindFirstChild(
					"Event"
				)

			if ActionSign
				and Event
				and ActionSign.Value
					== 20
			then
				table.insert(
					Results,
					Trigger
				)
			end
		end
	end

	return Results
end

--------------------------------------------------
-- OCCUPIED
--------------------------------------------------

function AutoPlay:IsTriggerOccupied(
	Trigger
)
	if not Trigger then
		return true
	end

	for _, Player in ipairs(
		Players:GetPlayers()
	) do
		if Player ~= LocalPlayer then
			local Character =
				Player.Character

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			if Root
				and Humanoid
				and Humanoid.Health > 0
			then
				if (
					Root.Position
					- Trigger.Position
				).Magnitude
					<= self.Config.TriggerOccupancyRadius
				then
					return true,
						Player
				end
			end
		end
	end

	return false,
		nil
end

--------------------------------------------------
-- UNREACHABLE COOLDOWN
--------------------------------------------------

function AutoPlay:MarkComputerUnreachable(
	Computer
)
	if not Computer then
		return
	end

	self._unreachableComputers[
		Computer
	] =
		os.clock()
		+ self.Config.UnreachableComputerCooldown
end

function AutoPlay:IsComputerTemporarilyUnreachable(
	Computer
)
	local UntilTime =
		self._unreachableComputers[
			Computer
		]

	if not UntilTime then
		return false
	end

	if os.clock()
		>= UntilTime
	then
		self._unreachableComputers[
			Computer
		] =
			nil

		return false
	end

	return true
end

--------------------------------------------------
-- AVAILABLE TRIGGERS
--------------------------------------------------

function AutoPlay:GetAvailableTriggers(
	Computer
)
	local Results = {}

	for _, Trigger in ipairs(
		self:GetComputerTriggers(
			Computer
		)
	) do
		if not self:IsTriggerOccupied(
			Trigger
		)
		then
			table.insert(
				Results,
				Trigger
			)
		end
	end

	return Results
end

--------------------------------------------------
-- PATH-BASED COMPUTER SELECTION
--------------------------------------------------

function AutoPlay:GetNearestComputerTarget()
	if not self.Navigator then
		return nil,
			nil
	end

	local BestComputer =
		nil

	local BestTrigger =
		nil

	local BestPathDistance =
		math.huge

	for _, Computer in ipairs(
		self:GetComputers()
	) do
		if not self:IsComputerDone(
			Computer
		)
			and not self:IsComputerTemporarilyUnreachable(
				Computer
			)
		then
			local FoundReachable =
				false

			for _, Trigger in ipairs(
				self:GetAvailableTriggers(
					Computer
				)
			) do
				--------------------------------------------------
				-- IMPORTANT:
				-- ACTUAL NAVIGATION DISTANCE.
				--
				-- A COMPUTER ONE FLOOR BELOW WILL NO LONGER
				-- LOOK "CLOSE" JUST BECAUSE X/Z MATCHES.
				--------------------------------------------------

				local Distance =
					self.Navigator:GetPathDistance(
						Trigger,

						{
							ProjectToGround =
								true,
						}
					)

				if Distance
					< math.huge
				then
					FoundReachable =
						true

					if Distance
							< BestPathDistance
						and Distance
							<= self.Config.MaxComputerPathDistance
					then
						BestPathDistance =
							Distance

						BestComputer =
							Computer

						BestTrigger =
							Trigger
					end
				end
			end

			if not FoundReachable then
				self:MarkComputerUnreachable(
					Computer
				)
			end
		end
	end

	return BestComputer,
		BestTrigger
end

--------------------------------------------------
-- COMPUTERS DONE
--------------------------------------------------

function AutoPlay:AreComputersDone()
	local Found = false

	for _, Computer in ipairs(
		self:GetComputers()
	) do
		Found = true

		if not self:IsComputerDone(
			Computer
		)
		then
			return false
		end
	end

	return Found
end

--------------------------------------------------
-- TRIGGER DISTANCE
--------------------------------------------------

function AutoPlay:GetTriggerDistances(
	Trigger
)
	local Root =
		self:GetRoot()

	if not Root
		or not Trigger
	then
		return math.huge,
			math.huge
	end

	local Difference =
		Trigger.Position
		- Root.Position

	local Horizontal =
		Vector3.new(
			Difference.X,
			0,
			Difference.Z
		).Magnitude

	local Vertical =
		math.abs(
			Difference.Y
		)

	return Horizontal,
		Vertical
end

--------------------------------------------------
-- NAVIGATE
--------------------------------------------------

function AutoPlay:NavigateTo(
	Target,
	Token,
	Options
)
	if not self.Navigator then
		return false,
			"NoNavigator"
	end

	Options =
		Options or {}

	return self.Navigator:MoveTo(
		Target,

		{
			ProjectToGround =
				Options.ProjectToGround,

			ShouldAbort =
				function()
					if not self.Config.Enabled
						or Token
							~= self._runToken
					then
						return "Stopped"
					end

					if not Options.IgnoreBeast
						and self:IsBeastClose()
					then
						return "Threat"
					end

					if Options.Computer
						and self:IsComputerDone(
							Options.Computer
						)
					then
						return "Completed"
					end

					if Options.Trigger
						and self:IsTriggerOccupied(
							Options.Trigger
						)
					then
						return "Occupied"
					end

					return nil
				end,
		}
	)
end

--------------------------------------------------
-- SETTLE INTO ACTUAL TRIGGER
--------------------------------------------------

function AutoPlay:SettleIntoTrigger(
	Trigger,
	Token,
	Computer
)
	if not Trigger
		or not Trigger.Parent
	then
		return false,
			"MissingTrigger"
	end

	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	local Horizontal,
		Vertical =
		self:GetTriggerDistances(
			Trigger
		)

	--------------------------------------------------
	-- WRONG FLOOR.
	--
	-- DO NOT WALK HORIZONTALLY TOWARD A COMPUTER
	-- THAT IS BELOW / ABOVE US.
	--------------------------------------------------

	if Vertical
		> self.Config.ComputerMaximumVerticalDifference
	then
		self:_SetStatus(
			"Finding computer floor"
		)

		local Reached,
			Reason =
			self:NavigateTo(
				Trigger,

				Token,

				{
					Computer =
						Computer,

					Trigger =
						Trigger,

					ProjectToGround =
						true,
				}
			)

		if not Reached then
			return false,
				Reason
		end

		Horizontal,
			Vertical =
			self:GetTriggerDistances(
				Trigger
			)

		--------------------------------------------------
		-- STILL WRONG LEVEL?
		--
		-- SKIP THIS COMPUTER TEMPORARILY.
		--------------------------------------------------

		if Vertical
			> self.Config.ComputerMaximumVerticalDifference
		then
			return false,
				"WrongLevel"
		end
	end

	--------------------------------------------------
	-- NOW WE KNOW WE ARE ON THE SAME FLOOR.
	--------------------------------------------------

	if self.Navigator then
		self.Navigator:Cancel()
	end

	Root =
		self:GetRoot()

	Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	local Destination =
		Vector3.new(
			Trigger.Position.X,
			Root.Position.Y,
			Trigger.Position.Z
		)

	Humanoid:MoveTo(
		Destination
	)

	local Started =
		os.clock()

	local PreviousPosition =
		Root.Position

	local LastMovement =
		os.clock()

	local LastJump =
		0

	while os.clock()
		- Started
		< self.Config.TriggerMoveTimeout
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false,
				"Stopped"
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		if Computer
			and self:IsComputerDone(
				Computer
			)
		then
			return true,
				"Completed"
		end

		Root =
			self:GetRoot()

		Humanoid =
			self:GetHumanoid()

		if not Root
			or not Humanoid
		then
			return false,
				"NoCharacter"
		end

		Horizontal,
			Vertical =
			self:GetTriggerDistances(
				Trigger
			)

		--------------------------------------------------
		-- CLOSE ENOUGH AND SAME FLOOR
		--------------------------------------------------

		if Horizontal
				<= self.Config.ComputerCenterDistance
			and Vertical
				<= self.Config.ComputerMaximumVerticalDifference
		then
			Humanoid:MoveTo(
				Root.Position
			)

			task.wait(
				self.Config.TriggerSettleTime
			)

			return true,
				"Reached"
		end

		--------------------------------------------------
		-- WE SOMEHOW CHANGED FLOORS
		--------------------------------------------------

		if Vertical
			> self.Config.ComputerMaximumVerticalDifference
		then
			return false,
				"WrongLevel"
		end

		--------------------------------------------------
		-- PROGRESS
		--------------------------------------------------

		if (
			Root.Position
			- PreviousPosition
		).Magnitude
			>= 0.2
		then
			PreviousPosition =
				Root.Position

			LastMovement =
				os.clock()
		end

		--------------------------------------------------
		-- STUCK NEXT TO FURNITURE -> JUMP
		--------------------------------------------------

		if os.clock()
				- LastMovement
				>= 0.35
			and Humanoid.FloorMaterial
				~= Enum.Material.Air
			and os.clock()
				- LastJump
				>= 0.22
		then
			LastJump =
				os.clock()

			Humanoid.Jump =
				true

			Humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)

			Humanoid:MoveTo(
				Destination
			)

			LastMovement =
				os.clock()
		end

		RunService.Heartbeat:Wait()
	end

	return false,
		"TriggerPositionTimeout"
end

