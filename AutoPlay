local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local AutoPlay = {}

--------------------------------------------------
-- CONFIG
--------------------------------------------------

AutoPlay.Config = {
	Enabled = false,

	--------------------------------------------------
	-- PATHFINDING
	--------------------------------------------------

	AgentRadius = 2,
	AgentHeight = 5,
	AgentCanJump = true,

	WaypointSpacing = 3,

	ArrivalDistance = 3.5,

	WaypointTimeout = 4,

	PathRetries = 3,

	--------------------------------------------------
	-- COMPUTERS
	--------------------------------------------------

	TriggerOccupancyRadius = 4.5,

	ComputerDoneColor =
		Color3.fromRGB(
			40,
			127,
			71
		),

	--------------------------------------------------
	-- BEAST
	--------------------------------------------------

	BeastAvoidDistance = 15,

	BeastResumeDistance = 22,

	HideDepth = 18,

	HideTweenTime = 0.3,

	--------------------------------------------------
	-- DOORS
	--------------------------------------------------

	DoorSearchRadius = 12,

	DoorOpenTimeout = 3,
}

--------------------------------------------------
-- STATE
--------------------------------------------------

AutoPlay._runToken = 0

AutoPlay._moveGeneration = 0

AutoPlay._initialized = false

AutoPlay._statusLabel = nil
AutoPlay._objectiveLabel = nil

AutoPlay._progressFill = nil
AutoPlay._progressLabel = nil

AutoPlay._handlers = {
	UseComputer = nil,
	StopComputer = nil,
	OpenDoor = nil,
	OpenExit = nil,
	Escape = nil,

	GetProgress = nil,
}

--------------------------------------------------
-- INIT
--------------------------------------------------

function AutoPlay:Init(Handlers)
	if self._initialized then
		return
	end

	self._initialized = true

	Handlers =
		Handlers or {}

	for Name, Callback
		in pairs(
			Handlers
		)
	do
		if self._handlers[Name]
				~= nil
			or type(Callback)
				== "function"
		then
			self._handlers[Name] =
				Callback
		end
	end
end

--------------------------------------------------
-- HANDLERS
--------------------------------------------------

function AutoPlay:SetHandler(
	Name,
	Callback
)
	self._handlers[Name] =
		Callback
end

function AutoPlay:_Call(
	Name,
	...
)
	local Callback =
		self._handlers[
			Name
		]

	if type(Callback)
		~= "function"
	then
		return nil
	end

	local Success, Result =
		pcall(
			Callback,
			...
		)

	if not Success then
		warn(
			"[AutoPlay]",
			Name,
			Result
		)

		return nil
	end

	return Result
end

--------------------------------------------------
-- STATUS
--------------------------------------------------

function AutoPlay:_SetStatus(Text)
	if self._statusLabel then
		self._statusLabel:SetText(
			"Status: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetObjective(Text)
	if self._objectiveLabel then
		self._objectiveLabel:SetText(
			"Objective: "
				.. tostring(Text)
		)
	end
end

function AutoPlay:_SetProgress(Value)
	Value =
		math.clamp(
			tonumber(Value)
				or 0,
			0,
			1
		)

	if self._progressFill then
		self._progressFill.Size =
			UDim2.fromScale(
				Value,
				1
			)
	end

	if self._progressLabel then
		self._progressLabel.Text =
			("%d%%"):format(
				math.floor(
					Value * 100
				)
			)
	end
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

function AutoPlay:GetCharacter()
	return LocalPlayer.Character
end

function AutoPlay:GetHumanoid()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass(
		"Humanoid"
	)
end

function AutoPlay:GetRoot()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- PLAYER STATS
--------------------------------------------------

function AutoPlay:GetStats(
	Player
)
	if not Player then
		return nil
	end

	local ModuleScript =
		Player:FindFirstChild(
			"TempPlayerStatsModule"
		)

	if not ModuleScript then
		return nil
	end

	local Success, Module =
		pcall(
			require,
			ModuleScript
		)

	if Success then
		return Module
	end

	return nil
end

--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success, Result =
			pcall(function()
				return Stats.GetValue(
					"IsBeast"
				)
			end)

		if Success
			and Result == true
		then
			return true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- COMPUTER DONE COLOR
--------------------------------------------------

local function ColorMatches(
	A,
	B
)
	local Tolerance =
		1 / 255

	return math.abs(A.R - B.R)
			<= Tolerance
		and math.abs(A.G - B.G)
			<= Tolerance
		and math.abs(A.B - B.B)
			<= Tolerance
end

function AutoPlay:IsComputerDone(
	Computer
)
	if not Computer then
		return true
	end

	local Screen =
		Computer:FindFirstChild(
			"Screen"
		)

	if not Screen
		or not Screen:IsA(
			"BasePart"
		)
	then
		return false
	end

	return ColorMatches(
		Screen.Color,
		self.Config.ComputerDoneColor
	)
end

