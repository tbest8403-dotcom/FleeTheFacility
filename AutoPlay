function AutoPlay:GetDoorTrigger(
	Door
)
	if not Door then
		return nil
	end

	local Trigger =
		Door:FindFirstChild(
			"DoorTrigger",
			true
		)

	if Trigger
		and Trigger:IsA(
			"BasePart"
		)
	then
		return Trigger
	end

	return nil
end

function AutoPlay:IsDoorOpen(
	Door
)
	local Trigger =
		self:GetDoorTrigger(
			Door
		)

	if not Trigger then
		return true
	end

	local ActionSign =
		Trigger:FindFirstChild(
			"ActionSign"
		)

	if not ActionSign then
		return false
	end

	--------------------------------------------------
	-- 10 = OPEN DOOR
	-- 11 = CLOSE DOOR
	--------------------------------------------------

	return ActionSign.Value
		== 11
end

function AutoPlay:FindDoorOnRoute(
	StartPosition,
	TargetPosition
)
	local BestDoor = nil

	local BestTrigger = nil

	local BestAlpha =
		math.huge

	for _, Door
		in ipairs(
			self:GetDoors()
		)
	do
		if not self:IsDoorOpen(
			Door
		)
		then
			local Trigger =
				self:GetDoorTrigger(
					Door
				)

			if Trigger then
				local Distance,
					Alpha =
					DistanceToSegment(
						Trigger.Position,
						StartPosition,
						TargetPosition
					)

				if Distance
					<= self.Config.DoorRouteDistance
					and Alpha > 0.03
					and Alpha < 0.97
					and Alpha
						< BestAlpha
				then
					BestDoor =
						Door

					BestTrigger =
						Trigger

					BestAlpha =
						Alpha
				end
			end
		end
	end

	return BestDoor,
		BestTrigger
end

--------------------------------------------------
-- PATH
--------------------------------------------------

function AutoPlay:CreatePath(
	StartPosition,
	TargetPosition
)
	local Path =
		PathfindingService:CreatePath({
			AgentRadius =
				self.Config.AgentRadius,

			AgentHeight =
				self.Config.AgentHeight,

			AgentCanJump =
				self.Config.AgentCanJump,

			WaypointSpacing =
				self.Config.WaypointSpacing,
		})

	local Success =
		pcall(function()
			Path:ComputeAsync(
				StartPosition,
				TargetPosition
			)
		end)

	if not Success then
		return nil
	end

	if Path.Status
		~= Enum.PathStatus.Success
	then
		return nil
	end

	return Path
end

