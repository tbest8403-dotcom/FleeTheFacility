--------------------------------------------------
-- DISTANCE TO ROUTE
--------------------------------------------------

local function DistanceToSegment(
	Point,
	A,
	B
)
	local AB =
		B - A

	local LengthSquared =
		AB:Dot(
			AB
		)

	if LengthSquared
		<= 0
	then
		return (
			Point - A
		).Magnitude,
			0
	end

	local Alpha =
		(
			Point - A
		):Dot(
			AB
		)
		/ LengthSquared

	Alpha =
		math.clamp(
			Alpha,
			0,
			1
		)

	local Closest =
		A
		+ AB * Alpha

	return (
		Point - Closest
	).Magnitude,
		Alpha
end

--------------------------------------------------
-- FIND DOOR ON ROUTE
--------------------------------------------------

function AutoPlay:FindDoorOnRoute(
	TargetPosition
)
	local Root =
		self:GetRoot()

	if not Root then
		return nil,
			nil
	end

	local BestDoor =
		nil

	local BestTrigger =
		nil

	local BestAlpha =
		math.huge

	for _, Door
		in ipairs(
			self:GetDoors()
		)
	do
		if not self:IsDoorOpen(
			Door
		)
		then
			local Trigger =
				self:GetDoorTrigger(
					Door
				)

			if Trigger then
				local Distance,
					Alpha =
					DistanceToSegment(
						Trigger.Position,
						Root.Position,
						TargetPosition
					)

				if Distance
						<= self.Config.DoorRouteDistance
					and Alpha > 0.03
					and Alpha < 0.97
					and Alpha
						< BestAlpha
				then
					BestDoor =
						Door

					BestTrigger =
						Trigger

					BestAlpha =
						Alpha
				end
			end
		end
	end

	return BestDoor,
		BestTrigger
end

--------------------------------------------------
-- NAVIGATION
--------------------------------------------------

function AutoPlay:NavigateTo(
	Target,
	Token,
	Options
)
	if not self.Navigator then
		return false,
			"NoNavigator"
	end

	Options =
		Options or {}

	return self.Navigator:MoveTo(
		Target,
		{
			ProjectToGround =
				Options.ProjectToGround,

			ShouldAbort =
				function()
					if not self.Config.Enabled
						or Token
							~= self._runToken
					then
						return "Stopped"
					end

					if not Options.IgnoreBeast
						and self:IsBeastClose()
					then
						return "Threat"
					end

					if Options.Computer
						and self:IsComputerDone(
							Options.Computer
						)
					then
						return "Completed"
					end

					if Options.Trigger then
						local Occupied =
							self:IsTriggerOccupied(
								Options.Trigger
							)

						if Occupied then
							return "Occupied"
						end
					end

					return nil
				end,
		}
	)
end

--------------------------------------------------
-- OPEN SINGLE DOOR
--------------------------------------------------

function AutoPlay:OpenDoor(
	Door,
	Trigger,
	Token
)
	if not Door
		or not Trigger
	then
		return false
	end

	if self:IsDoorOpen(
		Door
	)
	then
		return true
	end

	self:_SetStatus(
		"Opening door"
	)

	local Reached,
		Reason =
		self:NavigateTo(
			Trigger,
			Token,
			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		return false,
			Reason
	end

	if not self:PulseAction(
		Trigger,
		0.14
	)
	then
		return false
	end

	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.DoorOpenTimeout
	do
		if self:IsDoorOpen(
			Door
		)
		then
			return true
		end

		if self:IsBeastClose() then
			return false,
				"Threat"
		end

		task.wait(
			0.05
		)
	end

	return self:IsDoorOpen(
		Door
	)
end

--------------------------------------------------
-- NAVIGATE WITH DOOR SUPPORT
--------------------------------------------------

function AutoPlay:NavigateWithDoors(
	Target,
	Token,
	Options
)
	Options =
		Options or {}

	local TargetPosition

	if typeof(Target)
		== "Vector3"
	then
		TargetPosition =
			Target

	elseif typeof(Target)
		== "CFrame"
	then
		TargetPosition =
			Target.Position

	elseif typeof(Target)
			== "Instance"
		and Target:IsA(
			"BasePart"
		)
	then
		TargetPosition =
			Target.Position

	else
		return false,
			"InvalidTarget"
	end

	local Door,
		DoorTrigger =
		self:FindDoorOnRoute(
			TargetPosition
		)

	if Door
		and DoorTrigger
	then
		local Opened,
			Reason =
			self:OpenDoor(
				Door,
				DoorTrigger,
				Token
			)

		if not Opened
			and Reason
				== "Threat"
		then
			return false,
				Reason
		end

		task.wait(
			0.08
		)
	end

	local Reached,
		Reason =
		self:NavigateTo(
			Target,
			Token,
			Options
		)

	if not Reached
		and (
			Reason == "Blocked"
			or Reason == "Repath"
		)
	then
		Door,
			DoorTrigger =
			self:FindDoorOnRoute(
				TargetPosition
			)

		if Door
			and DoorTrigger
		then
			local Opened,
				DoorReason =
				self:OpenDoor(
					Door,
					DoorTrigger,
					Token
				)

			if not Opened
				and DoorReason
					== "Threat"
			then
				return false,
					DoorReason
			end

			task.wait(
				0.08
			)

			return self:NavigateTo(
				Target,
				Token,
				Options
			)
		end
	end

	return Reached,
		Reason
end

--------------------------------------------------
-- BEAST HIDE
--------------------------------------------------

function AutoPlay:HideFromBeast(
	Token
)
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	local ReturnCFrame =
		Root.CFrame

	local HiddenCFrame =
		ReturnCFrame
		+ Vector3.new(
			0,
			-self.Config.HideDepth,
			0
		)

	self:_SetStatus(
		"Beast nearby - hiding"
	)

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Humanoid.AutoRotate =
		false

	Root.Anchored =
		true

	local DownTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					HiddenCFrame,
			}
		)

	DownTween:Play()

	DownTween.Completed:Wait()

	while self.Config.Enabled
		and Token
			== self._runToken
		and self:GetBeastDistance()
			< self.Config.BeastResumeDistance
	do
		task.wait(
			0.1
		)
	end

	if not Root.Parent then
		return false
	end

	if not self.Config.Enabled
		or Token
			~= self._runToken
	then
		Root.Anchored =
			OriginalAnchored

		Humanoid.AutoRotate =
			OriginalAutoRotate

		return false
	end

	self:_SetStatus(
		"Returning"
	)

	local UpTween =
		TweenService:Create(
			Root,
			TweenInfo.new(
				self.Config.HideTweenTime,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					ReturnCFrame,
			}
		)

	UpTween:Play()

	UpTween.Completed:Wait()

	Root.Anchored =
		OriginalAnchored

	Humanoid.AutoRotate =
		OriginalAutoRotate

	return true
end

--------------------------------------------------
-- HACK COMPUTER
--------------------------------------------------

function AutoPlay:HackComputer(
	Computer,
	Trigger,
	Token
)
	if not Computer
		or not Trigger
	then
		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		return false
	end

	self:_SetObjective(
		"Computer"
	)

	self:_SetStatus(
		"Going to computer"
	)

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,
			Token,
			{
				Computer =
					Computer,

				Trigger =
					Trigger,

				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	if self:IsComputerDone(
		Computer
	)
	then
		return true
	end

	if self:IsTriggerOccupied(
		Trigger
	)
	then
		self:_SetStatus(
			"Spot taken"
		)

		return false
	end

	if self:IsBeastClose() then
		self:HideFromBeast(
			Token
		)

		return false
	end

	self:_SetStatus(
		"Hacking"
	)

	if not self:StartAction(
		Trigger
	)
	then
		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsComputerDone(
			Computer
		)
		then
			self:_SetProgress(
				1
			)

			break
		end

		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		self:HandleSkillCheck()

		if os.clock()
			- Started
			>= self.Config.ComputerTimeout
		then
			self:_SetStatus(
				"Hack timeout"
			)

			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	if self:IsComputerDone(
		Computer
	)
	then
		self:_SetStatus(
			"Computer complete"
		)

		return true
	end

	return false
end

--------------------------------------------------
-- EXIT
--------------------------------------------------

function AutoPlay:GetNearestExit()
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local BestExit =
		nil

	local BestDistance =
		math.huge

	for _, Object
		in ipairs(
			Workspace:GetDescendants()
		)
	do
		if Object.Name
			== "ExitDoor"
		then
			local Trigger =
				Object:FindFirstChild(
					"ExitDoorTrigger",
					true
				)

			if Trigger
				and Trigger:IsA(
					"BasePart"
				)
			then
				local Distance =
					(
						Root.Position
						- Trigger.Position
					).Magnitude

				if Distance
					< BestDistance
				then
					BestDistance =
						Distance

					BestExit =
						Object
				end
			end
		end
	end

	return BestExit
end

--------------------------------------------------
-- EXIT ACTION
--------------------------------------------------

function AutoPlay:UseExit(
	Exit,
	Token
)
	if not Exit then
		return false
	end

	local Trigger =
		Exit:FindFirstChild(
			"ExitDoorTrigger",
			true
		)

	if not Trigger
		or not Trigger:IsA(
			"BasePart"
		)
	then
		return false
	end

	self:_SetObjective(
		"Exit"
	)

	self:_SetStatus(
		"Going to exit"
	)

	local Reached,
		Reason =
		self:NavigateWithDoors(
			Trigger,
			Token,
			{
				ProjectToGround =
					true,
			}
		)

	if not Reached then
		if Reason
			== "Threat"
		then
			self:HideFromBeast(
				Token
			)
		end

		return false
	end

	self:_SetStatus(
		"Opening exit"
	)

	if not self:StartAction(
		Trigger
	)
	then
		return false
	end

	local Started =
		os.clock()

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeastClose() then
			self:LeaveTrigger()

			self:HideFromBeast(
				Token
			)

			return false
		end

		self:_SetProgress(
			self:GetActionProgress()
		)

		local ActionSign =
			Trigger:FindFirstChild(
				"ActionSign"
			)

		if ActionSign
			and ActionSign.Value
				~= 12
		then
			break
		end

		if os.clock()
			- Started
			>= self.Config.ExitOpenTimeout
		then
			break
		end

		task.wait(
			0.05
		)
	end

	self:LeaveTrigger()

	local ExitArea =
		Exit:FindFirstChild(
			"ExitArea",
			true
		)

	if not ExitArea then
		ExitArea =
			Exit:FindFirstChild(
				"ExistArea",
				true
			)
	end

	if not ExitArea
		or not ExitArea:IsA(
			"BasePart"
		)
	then
		self:_SetStatus(
			"Exit area not found"
		)

		return false
	end

	self:_SetStatus(
		"Escaping"
	)

	local Escaped =
		self:NavigateWithDoors(
			ExitArea,
			Token,
			{
				IgnoreBeast =
					true,

				ProjectToGround =
					true,
			}
		)

	if not Escaped then
		return false
	end

	self:_SetStatus(
		"Escaped"
	)

	return true
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

function AutoPlay:_Run(
	Token
)
	self:_SetStatus(
		"Starting"
	)

	self:_SetObjective(
		"None"
	)

	self:_SetProgress(
		0
	)

	while self.Config.Enabled
		and Token
			== self._runToken
	do
		if self:IsBeast(
			LocalPlayer
		)
		then
			self:_SetStatus(
				"Waiting"
			)

			task.wait(
				0.5
			)

			continue
		end

		if self:IsBeastClose() then
			self:HideFromBeast(
				Token
			)

			continue
		end

		if not self:AreComputersDone() then
			local Computer,
				Trigger =
				self:GetNearestComputerTarget()

			if Computer
				and Trigger
			then
				self:HackComputer(
					Computer,
					Trigger,
					Token
				)
			else
				self:_SetStatus(
					"Waiting for free computer"
				)

				task.wait(
					0.25
				)
			end

			continue
		end

		local Exit =
			self:GetNearestExit()

		if not Exit then
			self:_SetStatus(
				"Searching for exit"
			)

			task.wait(
				0.5
			)

			continue
		end

		local Escaped =
			self:UseExit(
				Exit,
				Token
			)

		if Escaped then
			self.Config.Enabled =
				false

			break
		end

		task.wait(
			0.2
		)
	end

	if self.Navigator then
		self.Navigator:Cancel()
	end

	self:LeaveTrigger()

	self:_SetProgress(
		0
	)
end

--------------------------------------------------
-- ENABLE
--------------------------------------------------

function AutoPlay:SetEnabled(
	Enabled
)
	Enabled =
		Enabled == true

	if self.Config.Enabled
		== Enabled
	then
		return
	end

	self.Config.Enabled =
		Enabled

	self._runToken += 1

	local Token =
		self._runToken

	if not Enabled then
		if self.Navigator then
			self.Navigator:Cancel()
		end

		self:LeaveTrigger()

		self:_SetStatus(
			"Disabled"
		)

		self:_SetObjective(
			"None"
		)

		self:_SetProgress(
			0
		)

		print(
			("[FleeTheFacility] %s %s disabled")
				:format(
					self.Name,
					self.Version
				)
		)

		return
	end

	print(
		("[FleeTheFacility] %s %s enabled")
			:format(
				self.Name,
				self.Version
			)
	)

	task.spawn(
		function()
			self:_Run(
				Token
			)
		end
	)
end

