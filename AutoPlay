--------------------------------------------------
-- BEAST
--------------------------------------------------

function AutoPlay:IsBeast(
	Player
)
	if not Player then
		return false
	end

	local Stats =
		self:GetStats(
			Player
		)

	if Stats
		and type(
			Stats.GetValue
		) == "function"
	then
		local Success,
			Value =
			pcall(
				function()
					return Stats.GetValue(
						"IsBeast"
					)
				end
			)

		if Success
			and Value == true
		then
			return true
		end
	end

	local Character =
		Player.Character

	if Character
		and Character:FindFirstChild(
			"BeastPowers"
		)
	then
		return true
	end

	return false
end

function AutoPlay:GetBeast()
	for _, Player
		in ipairs(
			Players:GetPlayers()
		)
	do
		if Player ~= LocalPlayer
			and self:IsBeast(
				Player
			)
		then
			return Player
		end
	end

	return nil
end

function AutoPlay:GetBeastDistance()
	local Root =
		self:GetRoot()

	local Beast =
		self:GetBeast()

	if not Root
		or not Beast
		or not Beast.Character
	then
		return math.huge
	end

	local BeastRoot =
		Beast.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not BeastRoot then
		return math.huge
	end

	return (
		BeastRoot.Position
		- Root.Position
	).Magnitude
end

function AutoPlay:IsBeastClose()
	return self:GetBeastDistance()
		<= self.Config.BeastAvoidDistance
end

--------------------------------------------------
-- CANCEL MOVEMENT
--------------------------------------------------

function AutoPlay:CancelTravel()
	self._travelGeneration += 1
end

--------------------------------------------------
-- YAW
--------------------------------------------------

function AutoPlay:GetYawRotation()
	local Root =
		self:GetRoot()

	if not Root then
		return CFrame.new()
	end

	local _,
		Y,
		_ =
		Root.CFrame:ToOrientation()

	return CFrame.Angles(
		0,
		Y,
		0
	)
end

--------------------------------------------------
-- SMOOTH POSITION SEGMENT
--
-- IMPORTANT:
-- MOVEMENT SPEED IS READ FROM HUMANOID.WALKSPEED
-- EVERY FRAME.
--------------------------------------------------

function AutoPlay:MoveSegment(
	TargetPosition,
	Token,
	TravelGeneration,
	IgnoreBeast,
	Rotation
)
	while true do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false,
				"Stopped"
		end

		if TravelGeneration
			~= self._travelGeneration
		then
			return false,
				"Cancelled"
		end

		if not IgnoreBeast
			and self:IsBeastClose()
		then
			return false,
				"Threat"
		end

		local Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		local Difference =
			TargetPosition
			- Root.Position

		local Distance =
			Difference.Magnitude

		if Distance
			<= self.Config.TravelReachDistance
		then
			Root.CFrame =
				CFrame.new(
					TargetPosition
				)
				* Rotation

			return true,
				"Reached"
		end

		--------------------------------------------------
		-- WAIT ONE PHYSICS FRAME
		--------------------------------------------------

		local DeltaTime =
			RunService.Heartbeat:Wait()

		--------------------------------------------------
		-- READ WALKSPEED LIVE
		--------------------------------------------------

		local Speed =
			self:GetTravelSpeed()

		--------------------------------------------------
		-- WALKSPEED 0 = DON'T MOVE
		--------------------------------------------------

		if Speed <= 0 then
			continue
		end

		local Step =
			math.min(
				Distance,
				Speed * DeltaTime
			)

		local NewPosition =
			Root.Position
			+ Difference.Unit
				* Step

		Root.CFrame =
			CFrame.new(
				NewPosition
			)
			* Rotation

		Root.AssemblyLinearVelocity =
			Vector3.zero

		Root.AssemblyAngularVelocity =
			Vector3.zero
	end
end

--------------------------------------------------
-- SMOOTH UNDERGROUND TRAVEL
--------------------------------------------------

function AutoPlay:SmoothTravelTo(
	Target,
	Token,
	IgnoreBeast
)
	local TargetPosition

	if typeof(Target)
		== "Vector3"
	then
		TargetPosition =
			Target

	elseif typeof(Target)
		== "CFrame"
	then
		TargetPosition =
			Target.Position

	elseif typeof(Target)
			== "Instance"
		and Target:IsA(
			"BasePart"
		)
	then
		TargetPosition =
			Target.Position

	else
		return false,
			"InvalidTarget"
	end

	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return false,
			"NoCharacter"
	end

	--------------------------------------------------
	-- CANCEL OLD TRAVEL
	--------------------------------------------------

	self:CancelTravel()

	local TravelGeneration =
		self._travelGeneration

	--------------------------------------------------
	-- SAVE STATE
	--------------------------------------------------

	local OriginalAnchored =
		Root.Anchored

	local OriginalAutoRotate =
		Humanoid.AutoRotate

	local Rotation =
		self:GetYawRotation()

	Root.Anchored = true

	Humanoid.AutoRotate = false

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	local function Restore()
		local CurrentRoot =
			self:GetRoot()

		local CurrentHumanoid =
			self:GetHumanoid()

		if CurrentRoot then
			CurrentRoot.AssemblyLinearVelocity =
				Vector3.zero

			CurrentRoot.AssemblyAngularVelocity =
				Vector3.zero

			CurrentRoot.Anchored =
				OriginalAnchored
		end

		if CurrentHumanoid then
			CurrentHumanoid.AutoRotate =
				OriginalAutoRotate
		end
	end

	--------------------------------------------------
	-- 1. 20 STUDS DOWN
	--------------------------------------------------

	self:_SetStatus(
		"Moving down"
	)

	local DownPosition =
		Root.Position
		- Vector3.new(
			0,
			self.Config.TravelDepth,
			0
		)

	local Success,
		Reason =
		self:MoveSegment(
			DownPosition,
			Token,
			TravelGeneration,
			IgnoreBeast,
			Rotation
		)

	if not Success then
		Restore()

		return false,
			Reason
	end

	--------------------------------------------------
	-- 2. MOVE TO 20 STUDS UNDER TARGET
	--------------------------------------------------

	self:_SetStatus(
		"Moving to target"
	)

	local UnderTarget =
		Vector3.new(
			TargetPosition.X,
			TargetPosition.Y
				- self.Config.TravelDepth,
			TargetPosition.Z
		)

	Success,
		Reason =
		self:MoveSegment(
			UnderTarget,
			Token,
			TravelGeneration,
			IgnoreBeast,
			Rotation
		)

	if not Success then
		Restore()

		return false,
			Reason
	end

	--------------------------------------------------
	-- 3. STRAIGHT UP TO TARGET
	--------------------------------------------------

	self:_SetStatus(
		"Moving up"
	)

	Success,
		Reason =
		self:MoveSegment(
			TargetPosition,
			Token,
			TravelGeneration,
			IgnoreBeast,
			Rotation
		)

	Restore()

	if not Success then
		return false,
			Reason
	end

	task.wait(
		self.Config.TriggerSettleTime
	)

	return true,
		"Reached"
end

--------------------------------------------------
-- LEAVE TRIGGER
--------------------------------------------------

function AutoPlay:LeaveTrigger()
	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				false
			)
		end
	)

	self:SetStatValue(
		"ActionInput",
		false
	)

	local Trigger =
		self._currentTrigger

	if Trigger
		and Trigger.Parent
	then
		local Event =
			Trigger:FindFirstChild(
				"Event"
			)

		if Event then
			pcall(
				function()
					RemoteEvent:FireServer(
						"Input",
						"Trigger",
						false,
						Event
					)
				end
			)
		end
	end

	self._currentTrigger =
		nil

	self._lastSkillGoal =
		nil
end

--------------------------------------------------
-- WAIT FOR TRIGGER
--------------------------------------------------

function AutoPlay:WaitForTriggerConfirmation(
	Token
)
	local Started =
		os.clock()

	while os.clock()
		- Started
		< self.Config.TriggerConfirmTimeout
	do
		if not self.Config.Enabled
			or Token
				~= self._runToken
		then
			return false
		end

		local OnTrigger =
			self:GetStatValue(
				"OnTrigger"
			)

		if OnTrigger == true then
			return true
		end

		if OnTrigger == nil
			and os.clock()
				- Started
				>= self.Config.TriggerSettleTime
		then
			return true
		end

		task.wait(
			0.025
		)
	end

	return true
end

--------------------------------------------------
-- ENTER TRIGGER
--------------------------------------------------

function AutoPlay:EnterTrigger(
	Trigger,
	Token
)
	if not Trigger
		or not Trigger.Parent
	then
		return false
	end

	local Event =
		Trigger:FindFirstChild(
			"Event"
		)

	if not Event then
		return false
	end

	if self._currentTrigger
		and self._currentTrigger
			~= Trigger
	then
		self:LeaveTrigger()
	end

	self._currentTrigger =
		Trigger

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Trigger",
				true,
				Event
			)
		end
	)

	self:WaitForTriggerConfirmation(
		Token
	)

	task.wait(
		self.Config.TriggerSettleTime
	)

	return true
end

--------------------------------------------------
-- START ACTION
--------------------------------------------------

function AutoPlay:StartAction(
	Trigger,
	Token
)
	if not self:EnterTrigger(
		Trigger,
		Token
	)
	then
		return false
	end

	pcall(
		function()
			RemoteEvent:FireServer(
				"Input",
				"Action",
				true
			)
		end
	)

	self:SetStatValue(
		"ActionInput",
		true
	)

	task.wait(
		self.Config.ActionSettleTime
	)

	return true
end

