--------------------------------------------------
-- INIT
--------------------------------------------------

function AutoPlay:Init(
	Navigator
)
	if self._initialized then
		return
	end

	self._initialized =
		true

	self.Navigator =
		Navigator

	print(
		("[FleeTheFacility] %s %s initialized"):format(
			self.Name,
			self.Version
		)
	)
end

--------------------------------------------------
-- UI
--------------------------------------------------

function AutoPlay:_SetStatus(
	Text
)
	if self._statusLabel then
		self._statusLabel:SetText(
			"Status: "
				.. tostring(
					Text
				)
		)
	end
end

function AutoPlay:_SetObjective(
	Text
)
	if self._objectiveLabel then
		self._objectiveLabel:SetText(
			"Objective: "
				.. tostring(
					Text
				)
		)
	end
end

function AutoPlay:_SetProgress(
	Value
)
	Value =
		math.clamp(
			tonumber(
				Value
			)
				or 0,
			0,
			1
		)

	if self._progressFill then
		self._progressFill.Size =
			UDim2.fromScale(
				Value,
				1
			)
	end

	if self._progressLabel then
		self._progressLabel.Text =
			string.format(
				"%d%%",

				math.floor(
					Value * 100
				)
			)
	end
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

function AutoPlay:GetCharacter()
	return LocalPlayer.Character
end

function AutoPlay:GetHumanoid()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass(
		"Humanoid"
	)
end

function AutoPlay:GetRoot()
	local Character =
		self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- STAT
--------------------------------------------------

function AutoPlay:GetStatValue(
	Name
)
	if not TempPlayerStatsModule
		or type(
			TempPlayerStatsModule.GetValue
		) ~= "function"
	then
		return nil
	end

	local Success,
		Value =
		pcall(
			function()
				return TempPlayerStatsModule.GetValue(
					Name
				)
			end
		)

	if not Success then
		return nil
	end

	return Value
end

function AutoPlay:SetStatValue(
	Name,
	Value
)
	if not TempPlayerStatsModule
		or type(
			TempPlayerStatsModule.SetValue
		) ~= "function"
	then
		return
	end

	pcall(
		function()
			TempPlayerStatsModule.SetValue(
				Name,
				Value
			)
		end
	)
end

