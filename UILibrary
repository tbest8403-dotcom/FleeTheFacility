function UILibrary:CreateWindow(Options)
	Options = Options or {}

	local Window = {}

	Window.Library = self

	Window.Key =
		Options.Key
		or Options.GuiName
		or "CustomUILibrary"

	Window.GuiName =
		Options.GuiName
		or Window.Key

	Window.Override =
		Options.Override ~= false

	Window.Title =
		Options.Title
		or "UI Library"

	Window.Size =
		Options.Size
		or Vector2.new(
			560,
			580
		)

	Window.Visible = true
	Window.Destroyed = false

	Window.Tabs = {}
	Window.ActiveTab = nil

	Window.Connections = {}
	Window.CleanupCallbacks = {}

	--------------------------------------------------
	-- OVERRIDE PREVIOUS INSTANCE
	--------------------------------------------------

	if Window.Override then
		local Previous =
			GlobalInstances[
				Window.Key
			]

		if Previous
			and Previous ~= Window
			and type(Previous.Destroy)
				== "function"
		then
			pcall(function()
				Previous:Destroy()
			end)
		end
	end

	local Parent =
		Options.Parent
		or LocalPlayer:WaitForChild(
			"PlayerGui"
		)

	--------------------------------------------------
	-- REMOVE STRANDED GUI
	--------------------------------------------------

	if Window.Override then
		local Existing =
			Parent:FindFirstChild(
				Window.GuiName
			)

		if Existing then
			pcall(function()
				Existing:Destroy()
			end)
		end
	end

	--------------------------------------------------
	-- CONNECTION MANAGER
	--------------------------------------------------

	function Window:Connect(
		Signal,
		Callback
	)
		if self.Destroyed then
			return nil
		end

		local Connection =
			Signal:Connect(
				Callback
			)

		table.insert(
			self.Connections,
			Connection
		)

		return Connection
	end

	--------------------------------------------------
	-- CUSTOM CLEANUP
	--------------------------------------------------

	function Window:AddCleanup(Callback)
		if type(Callback)
			~= "function"
		then
			return nil
		end

		table.insert(
			self.CleanupCallbacks,
			Callback
		)

		return Callback
	end

	Window.OnDestroy =
		Window.AddCleanup

	--------------------------------------------------
	-- DESTROY
	--------------------------------------------------

	function Window:Destroy()
		if self.Destroyed then
			return
		end

		self.Destroyed = true
		self.Visible = false

		--------------------------------------------------
		-- HIDE IMMEDIATELY
		--------------------------------------------------

		if self.Gui then
			pcall(function()
				self.Gui.Enabled = false
			end)
		end

		--------------------------------------------------
		-- RUN CUSTOM CLEANUP
		--------------------------------------------------

		for Index =
			#self.CleanupCallbacks,
			1,
			-1
		do
			local Callback =
				self.CleanupCallbacks[
					Index
				]

			pcall(
				Callback
			)
		end

		table.clear(
			self.CleanupCallbacks
		)

		--------------------------------------------------
		-- DISCONNECT EVERYTHING
		--------------------------------------------------

		for Index =
			#self.Connections,
			1,
			-1
		do
			local Connection =
				self.Connections[
					Index
				]

			pcall(function()
				if Connection
					and Connection.Connected
				then
					Connection:Disconnect()
				end
			end)
		end

		table.clear(
			self.Connections
		)

		--------------------------------------------------
		-- DESTROY GUI
		--------------------------------------------------

		if self.Gui then
			pcall(function()
				self.Gui:Destroy()
			end)

			self.Gui = nil
		end

		--------------------------------------------------
		-- REMOVE GLOBAL INSTANCE
		--------------------------------------------------

		if GlobalInstances[
			self.Key
		] == self
		then
			GlobalInstances[
				self.Key
			] = nil
		end
	end

