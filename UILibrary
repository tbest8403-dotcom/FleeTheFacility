					for _, Child
						in ipairs(
							OptionsFrame:GetChildren()
						)
					do
						if Child:IsA(
							"TextButton"
						) then
							Child:Destroy()
						end
					end

					for _, DropdownValue
						in ipairs(
							Values
						)
					do
						local ValueCopy =
							DropdownValue

						local OptionButton =
							Create(
								"TextButton",
								{
									Size =
										UDim2.new(
											1,
											0,
											0,
											28
										),

									BackgroundColor3 =
										UILibrary.Theme.Button,

									BorderSizePixel = 0,

									Text =
										tostring(
											ValueCopy
										),

									TextColor3 =
										UILibrary.Theme.Text,

									TextSize = 11,

									Font =
										Enum.Font.Gotham,

									AutoButtonColor = false,
								},
								OptionsFrame
							)

						AddCorner(
							OptionButton,
							5
						)

						local Connection =
							OptionButton
								.MouseButton1Click
								:Connect(
									function()
										Controller:Set(
											ValueCopy
										)

										SetOpen(
											false
										)
									end
								)

						table.insert(
							OptionConnections,
							Connection
						)
					end
				end

				function Controller:Set(
					Value,
					FireCallback
				)
					Current =
						Value

					UpdateText()

					if FireCallback ~= false then
						SafeCallback(
							Options.Callback,
							Current
						)
					end
				end

				function Controller:Get()
					return Current
				end

				function Controller:SetValues(
					NewValues
				)
					Values =
						NewValues
						or {}

					Rebuild()

					if Open then
						SetOpen(false)
						SetOpen(true)
					end
				end

				function Controller:GetValues()
					return Values
				end

				function Controller:Open()
					SetOpen(true)
				end

				function Controller:Close()
					SetOpen(false)
				end

				Window:Connect(
					Selection.MouseButton1Click,
					function()
						SetOpen(
							not Open
						)
					end
				)

				Rebuild()
				UpdateText()

				Controller.Instance =
					Control

				return Controller
			end

			--------------------------------------------------
			-- TARGET SELECTOR
			--------------------------------------------------

			function Section:AddTargetSelector(
				Options
			)
				Options =
					Options or {}

				local IncludeLocalPlayer =
					Options.IncludeLocalPlayer
						== true

				local function GetPlayerNames()
					local Names = {}

					for _, Player
						in ipairs(
							Players:GetPlayers()
						)
					do
						if
							IncludeLocalPlayer
							or Player
								~= LocalPlayer
						then
							table.insert(
								Names,
								Player.Name
							)
						end
					end

					table.sort(
						Names,
						function(A, B)
							return A:lower()
								< B:lower()
						end
					)

					return Names
				end

				local Dropdown =
					self:AddDropdown({
						Name =
							Options.Name
							or "Target",

						Placeholder =
							Options.Placeholder
							or "Select target",

						Values =
							GetPlayerNames(),

						Callback =
							function(Name)
								local Player =
									Players:FindFirstChild(
										tostring(
											Name
										)
									)

								SafeCallback(
									Options.Callback,
									Player
								)
							end,
					})

				local Controller = {}

				function Controller:Refresh()
					Dropdown:SetValues(
						GetPlayerNames()
					)
				end

				function Controller:Get()
					local Name =
						Dropdown:Get()

					if not Name then
						return nil
					end

					return Players:FindFirstChild(
						tostring(
							Name
						)
					)
				end

				function Controller:Set(
					PlayerOrName
				)
					if PlayerOrName == nil then
						Dropdown:Set(
							nil,
							false
						)

						return
					end

					local Name

					if typeof(
						PlayerOrName
					) == "Instance"
					then
						Name =
							PlayerOrName.Name
					else
						Name =
							tostring(
								PlayerOrName
							)
					end

					Dropdown:Set(
						Name
					)
				end

				Window:Connect(
					Players.PlayerAdded,
					function()
						Controller:Refresh()
					end
				)

				Window:Connect(
					Players.PlayerRemoving,
					function(Player)
						if Dropdown:Get()
							== Player.Name
						then
							Dropdown:Set(
								nil,
								false
							)
						end

						Controller:Refresh()
					end
				)

				Controller.Dropdown =
					Dropdown

				return Controller
			end

			--------------------------------------------------
			-- CUSTOM CONTAINER
			--------------------------------------------------

			function Section:AddCustom(
				Options
			)
				Options =
					Options or {}

				local Container =
					Create(
						"Frame",
						{
							Size =
								UDim2.new(
									1,
									0,
									0,
									Options.Height
										or 40
								),

							BackgroundColor3 =
								Options.BackgroundColor
								or UILibrary.Theme.Background3,

							BackgroundTransparency =
								Options.BackgroundTransparency
								or 0,

							BorderSizePixel = 0,
						},
						Content
					)

				if Options.Corner
					~= false
				then
					AddCorner(
						Container,
						Options.CornerRadius
							or 7
					)
				end

				local Result

				if type(
					Options.Builder
				) == "function"
				then
					Result =
						Options.Builder(
							Container,
							self,
							self.Tab,
							self.Window,
							UILibrary
						)
				end

				return Result
					or Container
			end

			--------------------------------------------------
			-- CUSTOM WIDGET
			--------------------------------------------------

			function Section:AddWidget(
				Name,
				Options
			)
				local Constructor =
					UILibrary.CustomWidgets[
						Name
					]

				assert(
					Constructor,
					"Unknown widget: "
						.. tostring(Name)
				)

				return Constructor(
					self,
					Options or {}
				)
			end

			return Section
		end

		--------------------------------------------------
		-- TARGET SECTION
		--------------------------------------------------

		function Tab:CreateTargetSection(
			Options
		)
			Options =
				Options or {}

			local Section =
				self:CreateSection(
					Options.Name
					or "Target"
				)

			Section.TargetSelector =
				Section:AddTargetSelector({
					Name =
						Options.TargetName
						or "Player",

					IncludeLocalPlayer =
						Options.IncludeLocalPlayer,

					Callback =
						Options.Callback,
				})

			return Section
		end

		--------------------------------------------------
		-- FIRST TAB
		--------------------------------------------------

		if Window.ActiveTab == nil then
			Tab:Select()
		end

		return Tab
	end

	return Window
end

return UILibrary
