	local function UpdateScale()
		if Window.Destroyed then
			return
		end

		local Camera =
			Workspace.CurrentCamera

		if not Camera then
			return
		end

		local Viewport =
			Camera.ViewportSize

		local ScaleX =
			Viewport.X
			/ (
				Window.Size.X
				+ 30
			)

		local ScaleY =
			Viewport.Y
			/ (
				Window.Size.Y
				+ 30
			)

		UIScale.Scale =
			Clamp(
				math.min(
					ScaleX,
					ScaleY,
					1
				),
				0.55,
				1
			)
	end

	local function BindCamera()
		if CameraConnection then
			pcall(function()
				CameraConnection:Disconnect()
			end)

			CameraConnection = nil
		end

		local Camera =
			Workspace.CurrentCamera

		if Camera then
			CameraConnection =
				Window:Connect(
					Camera:GetPropertyChangedSignal(
						"ViewportSize"
					),
					UpdateScale
				)
		end

		UpdateScale()
	end

	Window:Connect(
		Workspace:GetPropertyChangedSignal(
			"CurrentCamera"
		),
		BindCamera
