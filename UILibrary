function UILibrary:RegisterWidget(
	Name,
	Constructor
)
	assert(
		type(Name) == "string",
		"Widget name must be a string"
	)

	assert(
		type(Constructor) == "function",
		"Widget constructor must be a function"
	)

	self.CustomWidgets[Name] =
		Constructor
end

--------------------------------------------------
-- GET RUNNING WINDOW
--------------------------------------------------

function UILibrary:GetWindow(Key)
	return GlobalInstances[
		Key or "CustomUILibrary"
	]
end

--------------------------------------------------
-- DESTROY RUNNING WINDOW
--------------------------------------------------

function UILibrary:DestroyWindow(Key)
	local Window =
		GlobalInstances[
			Key or "CustomUILibrary"
		]

	if Window
		and type(Window.Destroy)
			== "function"
	then
		Window:Destroy()
	end
end

