-- STATE
--------------------------------------------------

Navigator._moveGeneration = 0

Navigator._character = nil

Navigator._agentSettings = nil

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

function Navigator:GetCharacter()
	return LocalPlayer.Character
end

function Navigator:GetHumanoid()
	local Character = self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass(
		"Humanoid"
	)
end

function Navigator:GetRoot()
	local Character = self:GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--------------------------------------------------
-- PART CHECK
--------------------------------------------------

function Navigator:IsAccessoryPart(
	Part
)
	local Parent = Part.Parent

	while Parent do
		if Parent:IsA("Accessory")
			or Parent:IsA("Tool")
		then
			return true
		end

		Parent = Parent.Parent
	end

	return false
end

--------------------------------------------------
-- BODY WIDTH
--------------------------------------------------

function Navigator:GetBodyWidth()
	local Character =
		self:GetCharacter()

	local Root =
		self:GetRoot()

	if not Character
		or not Root
	then
		return 2
	end

	local Width =
		math.max(
			Root.Size.X,
			Root.Size.Z
		)

	local Candidates = {
		"HumanoidRootPart",
		"Torso",
		"UpperTorso",
		"LowerTorso",
	}

	for _, Name in ipairs(
		Candidates
	) do
		local Part =
			Character:FindFirstChild(
				Name
			)

		if Part
			and Part:IsA(
				"BasePart"
			)
		then
			Width =
				math.max(
					Width,
					Part.Size.X,
					Part.Size.Z
				)
		end
	end

	return Width
end

--------------------------------------------------
-- BODY HEIGHT
--------------------------------------------------

function Navigator:GetBodyHeight()
	local Character =
		self:GetCharacter()

	if not Character then
		return 5
	end

	local MinimumY =
		math.huge

	local MaximumY =
		-math.huge

	for _, Object in ipairs(
		Character:GetDescendants()
	) do
		if Object:IsA("BasePart")
			and not self:IsAccessoryPart(
				Object
			)
		then
			local Half =
				Object.Size / 2

			for X = -1, 1, 2 do
				for Y = -1, 1, 2 do
					for Z = -1, 1, 2 do
						local Point =
							Object.CFrame
							* Vector3.new(
								Half.X * X,
								Half.Y * Y,
								Half.Z * Z
							)

						MinimumY =
							math.min(
								MinimumY,
								Point.Y
							)

						MaximumY =
							math.max(
								MaximumY,
								Point.Y
							)
					end
				end
			end
		end
	end

	if MinimumY == math.huge
		or MaximumY == -math.huge
	then
		return 5
	end

	return MaximumY
		- MinimumY
end

--------------------------------------------------
-- CAN JUMP
--------------------------------------------------

function Navigator:CanCharacterJump()
	local Humanoid =
		self:GetHumanoid()

	if not Humanoid then
		return true
	end

	if Humanoid.UseJumpPower then
		return Humanoid.JumpPower > 0
	end

	return Humanoid.JumpHeight > 0
end

--------------------------------------------------
-- CALCULATE AGENT
--------------------------------------------------

function Navigator:CalculateAgent()
	local Width =
		self:GetBodyWidth()

	local Height =
		self:GetBodyHeight()

	local Radius =
		math.clamp(
			Width / 2
				+ self.Config.RadiusPadding,

			self.Config.MinAgentRadius,

			self.Config.MaxAgentRadius
		)

	local AgentHeight =
		math.clamp(
			Height
				+ self.Config.HeightPadding,

			self.Config.MinAgentHeight,

			self.Config.MaxAgentHeight
		)

	local WaypointSpacing =
		math.clamp(
			Radius * 2.35,

			self.Config.MinWaypointSpacing,

			self.Config.MaxWaypointSpacing
		)

	self._agentSettings = {
		BodyWidth =
			Width,

		BodyHeight =
			Height,

		AgentRadius =
			Radius,

		AgentHeight =
			AgentHeight,

		WaypointSpacing =
			WaypointSpacing,

		AgentCanJump =
			self:CanCharacterJump(),
	}

	print(
		string.format(
			"[FleeTheFacility] Navigator Agent Radius %.2f | Height %.2f | Spacing %.2f",
			Radius,
			AgentHeight,
			WaypointSpacing
		)
	)

	return self._agentSettings
end

--------------------------------------------------
-- GET AGENT
--------------------------------------------------

function Navigator:GetAgentSettings()
	local Character =
		self:GetCharacter()

	if Character
		~= self._character
	then
		self._character =
			Character

		self._agentSettings =
			nil
	end

	if not self._agentSettings then
		return self:CalculateAgent()
	end

	return self._agentSettings
end

--------------------------------------------------
-- ROOT HEIGHT
--------------------------------------------------

function Navigator:GetRootHeight()
	local Root =
		self:GetRoot()

	local Humanoid =
		self:GetHumanoid()

	if not Root
		or not Humanoid
	then
		return 3
	end

	return Humanoid.HipHeight
		+ Root.Size.Y / 2
end

--------------------------------------------------
-- RAYCAST PARAMS
--------------------------------------------------

function Navigator:GetRaycastParams()
	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	local Character =
		self:GetCharacter()

	if Character then
		Params.FilterDescendantsInstances = {
			Character,
		}
	end

	Params.IgnoreWater =
		false

	return Params
end

--------------------------------------------------
-- PROJECT TO GROUND
--------------------------------------------------

function Navigator:GetGroundTarget(
	Position
)
	local Params =
		self:GetRaycastParams()

	local Origin =
		Position
		+ Vector3.new(
			0,
			self.Config.GroundProbeHeight,
			0
		)

	local Result =
		Workspace:Raycast(
			Origin,

			Vector3.new(
				0,
				-(
					self.Config.GroundProbeHeight
					+ self.Config.GroundProbeDepth
				),
				0
			),

			Params
		)

	if not Result then
		return Position
	end

	return Result.Position
		+ Vector3.new(
			0,
			self:GetRootHeight(),
			0
		)
end

--------------------------------------------------
-- NORMALIZE TARGET
--------------------------------------------------

function Navigator:GetTargetPosition(
	Target,
	Options
)
	local Position

	if typeof(Target)
		== "Vector3"
	then
		Position =
			Target

	elseif typeof(Target)
		== "CFrame"
	then
		Position =
			Target.Position

	elseif typeof(Target)
			== "Instance"
		and Target:IsA(
			"BasePart"
		)
	then
		Position =
			Target.Position

	else
		return nil
	end

	if not Options
		or Options.ProjectToGround
			~= false
	then
		Position =
			self:GetGroundTarget(
				Position
			)
	end

	return Position
end

--------------------------------------------------
-- CREATE PATH
--------------------------------------------------

function Navigator:CreatePath(
	StartPosition,
	TargetPosition
)
	local Agent =
		self:GetAgentSettings()

	local Path =
		PathfindingService:CreatePath({
			AgentRadius =
				Agent.AgentRadius,

			AgentHeight =
				Agent.AgentHeight,

			AgentCanJump =
				Agent.AgentCanJump,

			AgentCanClimb =
				false,

			WaypointSpacing =
				Agent.WaypointSpacing,
		})

	local Success =
		pcall(
			function()
				Path:ComputeAsync(
					StartPosition,
					TargetPosition
				)
			end
		)

	if not Success
		or Path.Status
			~= Enum.PathStatus.Success
	then
		return nil
	end

	return Path
end

--------------------------------------------------
-- PATH DISTANCE
--------------------------------------------------

function Navigator:GetPathDistance(
	Target,
	Options
)
	local Root =
		self:GetRoot()

	if not Root then
		return math.huge
	end

	Options =
		Options or {}

	local TargetPosition =
		self:GetTargetPosition(
			Target,
			Options
		)

	if not TargetPosition then
		return math.huge
	end

	local Path =
		self:CreatePath(
			Root.Position,
			TargetPosition
		)

	if not Path then
		return math.huge
	end

	local Waypoints =
		Path:GetWaypoints()

	if #Waypoints == 0 then
		return math.huge
	end

	local Distance = 0

	local Previous =
		Root.Position

	for _, Waypoint in ipairs(
		Waypoints
	) do
		Distance +=
			(
				Waypoint.Position
				- Previous
			).Magnitude

		Previous =
			Waypoint.Position
	end

	Distance +=
		(
			TargetPosition
			- Previous
		).Magnitude

	return Distance
end

--------------------------------------------------
-- CORRIDOR CHECK
--------------------------------------------------

function Navigator:HasClearCorridor(
	StartPosition,
	EndPosition
)
	local Difference =
		EndPosition
		- StartPosition

	if Difference.Magnitude <= 0.05 then
		return true
	end

	local Agent =
		self:GetAgentSettings()

	local Radius =
		Agent.AgentRadius
		+ self.Config.CorridorExtraPadding

	local Height =
		Agent.AgentHeight
		* self.Config.CorridorHeightScale

	local Start =
		StartPosition
		+ Vector3.new(
			0,
			Height / 2,
			0
		)

	local Finish =
		EndPosition
		+ Vector3.new(
			0,
			Height / 2,
			0
		)

	local Params =
		self:GetRaycastParams()

	local Result =
		Workspace:Blockcast(
			CFrame.new(Start),

			Vector3.new(
				Radius * 2,
				Height,
				Radius * 2
			),

			Finish - Start,

			Params
		)

	return Result == nil
end

--------------------------------------------------
-- SMOOTH PATH
--------------------------------------------------

function Navigator:SmoothWaypoints(
	Waypoints
)
	if not self.Config.SmoothWaypoints
		or #Waypoints <= 2
	then
		return Waypoints
	end

	local Results = {}

	local Index = 1

	table.insert(
		Results,
		Waypoints[Index]
	)

	while Index < #Waypoints do
		local BestIndex =
			Index + 1

		local Maximum =
			math.min(
				Index
					+ self.Config.MaxSmoothLookAhead,

				#Waypoints
			)

		for Candidate =
			Maximum,
			Index + 1,
			-1
		do
			local ContainsJump =
				false

			for Check =
				Index + 1,
				Candidate
			do
				if Waypoints[
					Check
				].Action
					== Enum.PathWaypointAction.Jump
				then
					ContainsJump =
						true

					break
				end
			end

			if not ContainsJump
				and self:HasClearCorridor(
					Waypoints[Index].Position,

					Waypoints[
						Candidate
					].Position
				)
			then
				BestIndex =
					Candidate

				break
			end
		end

		Index =
			BestIndex

		table.insert(
			Results,
			Waypoints[Index]
		)
	end

	return Results
end

--------------------------------------------------
-- CANCEL
--------------------------------------------------

function Navigator:Cancel()
	self._moveGeneration += 1

	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if Humanoid
		and Root
	then
		Humanoid:MoveTo(
			Root.Position
		)
	end
end

--------------------------------------------------
-- ABORT
--------------------------------------------------

function Navigator:CheckAbort(
	Generation,
	Options
)
	if Generation
		~= self._moveGeneration
	then
		return "Cancelled"
	end

	if Options
		and type(
			Options.ShouldAbort
		) == "function"
	then
		local Reason =
			Options.ShouldAbort()

		if Reason then
			return Reason
		end
	end

	return nil
end

--------------------------------------------------
-- JUMP
--------------------------------------------------

function Navigator:ForceJump()
	local Humanoid =
		self:GetHumanoid()

	if not Humanoid then
		return false
	end

	if Humanoid.FloorMaterial
		== Enum.Material.Air
	then
		return false
	end

	Humanoid.Jump =
		true

	Humanoid:ChangeState(
		Enum.HumanoidStateType.Jumping
	)

	return true
end

--------------------------------------------------
-- JUMPABLE OBSTACLE
--------------------------------------------------

function Navigator:HasJumpableObstacle(
	TargetPosition
)
	local Root =
		self:GetRoot()

	if not Root then
		return false
	end

	local Difference =
		TargetPosition
		- Root.Position

	local Flat =
		Vector3.new(
			Difference.X,
			0,
			Difference.Z
		)

	if Flat.Magnitude <= 0.1 then
		return false
	end

	local Direction =
		Flat.Unit
		* self.Config.ObstacleProbeDistance

	local Params =
		self:GetRaycastParams()

	local Low =
		Workspace:Raycast(
			Root.Position
				+ Vector3.new(
					0,
					self.Config.ObstacleLowHeight,
					0
				),

			Direction,

			Params
		)

	if not Low then
		return false
	end

	local High =
		Workspace:Raycast(
			Root.Position
				+ Vector3.new(
					0,
					self.Config.ObstacleHighHeight,
					0
				),

			Direction,

			Params
		)

	return High == nil
end

--------------------------------------------------
-- ESCAPE POINT
--------------------------------------------------

function Navigator:GetEscapePoint(
	TargetPosition,
	SeedOffset
)
	local Root =
		self:GetRoot()

	if not Root then
		return nil
	end

	local Params =
		self:GetRaycastParams()

	local BestPoint =
		nil

	local BestScore =
		math.huge

	for Index = 1,
		self.Config.EscapeDirections
	do
		local Angle =
			(
				(Index - 1)
				/ self.Config.EscapeDirections
			)
			* math.pi
			* 2

		Angle +=
			SeedOffset or 0

		local Direction =
			Vector3.new(
				math.cos(Angle),
				0,
				math.sin(Angle)
			)

		local Probe =
			Root.Position
			+ Direction
				* self.Config.EscapeRadius

		local Ground =
			Workspace:Raycast(
				Probe
					+ Vector3.new(
						0,
						self.Config.EscapeGroundProbeHeight,
						0
					),

				Vector3.new(
					0,
					-self.Config.EscapeGroundProbeDepth,
					0
				),

				Params
			)

		if Ground then
			local Point =
				Ground.Position
				+ Vector3.new(
					0,
					self:GetRootHeight(),
					0
				)

			local HeadClear =
				Workspace:Raycast(
					Ground.Position
						+ Vector3.new(
							0,
							0.5,
							0
						),

					Vector3.new(
						0,
						self:GetAgentSettings()
							.AgentHeight,
						0
					),

					Params
				)

			if not HeadClear then
				local Score =
					(
						Point
						- TargetPosition
					).Magnitude

				if Score < BestScore then
					BestScore =
						Score

					BestPoint =
						Point
				end
			end
		end
	end

	return BestPoint
end

--------------------------------------------------
-- LOCAL ESCAPE
--------------------------------------------------

function Navigator:TryLocalEscape(
	TargetPosition,
	Generation,
	Options
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	local StartingPosition =
		Root.Position

	for Attempt = 1,
		self.Config.MaxEscapeAttempts
	do
		local Abort =
			self:CheckAbort(
				Generation,
				Options
			)

		if Abort then
			return false,
				Abort
		end

		--------------------------------------------------
		-- JUMP FIRST
		--------------------------------------------------

		self:ForceJump()

		task.wait(
			0.04
		)

		--------------------------------------------------
		-- FIND AN OPEN LOCAL DIRECTION
		--------------------------------------------------

		local Point =
			self:GetEscapePoint(
				TargetPosition,

				Attempt
					* 0.47
			)

		if Point then
			Humanoid:MoveTo(
				Point
			)
		else
			Humanoid:MoveTo(
				TargetPosition
			)
		end

		local Started =
			os.clock()

		while os.clock()
			- Started
			< self.Config.EscapeMoveTimeout
		do
			local AbortReason =
				self:CheckAbort(
					Generation,
					Options
				)

			if AbortReason then
				return false,
					AbortReason
			end

			Root =
				self:GetRoot()

			if not Root then
				return false,
					"NoCharacter"
			end

			if (
				Root.Position
				- StartingPosition
			).Magnitude
				>= self.Config.EscapeMinimumMovement
			then
				return true,
					"Recovered"
			end

			RunService.Heartbeat:Wait()
		end
	end

	return false,
		"StillStuck"
end

--------------------------------------------------
-- SHOULD JUMP
--------------------------------------------------

function Navigator:ShouldJump(
	RootPosition,
	Waypoint
)
	if Waypoint.Action
		== Enum.PathWaypointAction.Jump
	then
		return true
	end

	return Waypoint.Position.Y
			- RootPosition.Y
		>= self.Config.ForceJumpHeightDifference
end

--------------------------------------------------
-- FOLLOW WAYPOINT
--------------------------------------------------

function Navigator:FollowWaypoint(
	Waypoint,
	Generation,
	Options,
	IsFinal
)
	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	local ReachDistance =
		IsFinal
			and self.Config.FinalReachDistance
			or self.Config.WaypointReachDistance

	local NeedsJump =
		self:ShouldJump(
			Root.Position,
			Waypoint
		)

	if NeedsJump then
		self:ForceJump()

		task.wait(
			0.04
		)
	end

	Humanoid:MoveTo(
		Waypoint.Position
	)

	local Started =
		os.clock()

	local LastProgress =
		os.clock()

	local PreviousPosition =
		Root.Position

	local PreviousDistance =
		(
			Waypoint.Position
			- Root.Position
		).Magnitude

	local LastJump =
		0

	local JumpRetries =
		0

	local StuckJumps =
		0

	while true do
		local Abort =
			self:CheckAbort(
				Generation,
				Options
			)

		if Abort then
			return false,
				Abort
		end

		Humanoid =
			self:GetHumanoid()

		Root =
			self:GetRoot()

		if not Humanoid
			or not Root
		then
			return false,
				"NoCharacter"
		end

		local Difference =
			Waypoint.Position
			- Root.Position

		local HorizontalDistance =
			Vector3.new(
				Difference.X,
				0,
				Difference.Z
			).Magnitude

		local VerticalDistance =
			math.abs(
				Difference.Y
			)

		--------------------------------------------------
		-- REACHED
		--------------------------------------------------

		if HorizontalDistance
				<= ReachDistance
			and VerticalDistance
				<= self.Config.MaxFinalVerticalDifference
		then
			return true,
				"Reached"
		end

		local CurrentDistance =
			Difference.Magnitude

		local Movement =
			(
				Root.Position
				- PreviousPosition
			).Magnitude

		local Improvement =
			PreviousDistance
			- CurrentDistance

		--------------------------------------------------
		-- MADE PROGRESS
		--------------------------------------------------

		if Movement
				>= self.Config.StuckMovementThreshold
			or Improvement
				>= self.Config.StuckDistanceImprovement
		then
			LastProgress =
				os.clock()

			PreviousPosition =
				Root.Position

			PreviousDistance =
				CurrentDistance

			StuckJumps =
				0
		end

		--------------------------------------------------
		-- PATH JUMP
		--------------------------------------------------

		if NeedsJump
			and Humanoid.FloorMaterial
				~= Enum.Material.Air
			and os.clock()
				- LastJump
				>= self.Config.JumpRetryDelay
			and JumpRetries
				< self.Config.MaxJumpRetries
		then
			JumpRetries += 1

			LastJump =
				os.clock()

			self:ForceJump()

			Humanoid:MoveTo(
				Waypoint.Position
			)
		end

		--------------------------------------------------
		-- WAYPOINT ABOVE US
		--------------------------------------------------

		if Difference.Y
				>= self.Config.ForceJumpHeightDifference
			and Humanoid.FloorMaterial
				~= Enum.Material.Air
			and os.clock()
				- LastJump
				>= self.Config.JumpRetryDelay
		then
			LastJump =
				os.clock()

			self:ForceJump()

			Humanoid:MoveTo(
				Waypoint.Position
			)
		end

		--------------------------------------------------
		-- LOW OBJECT IN FRONT
		--------------------------------------------------

		if Humanoid.FloorMaterial
				~= Enum.Material.Air
			and os.clock()
				- LastJump
				>= self.Config.ObstacleJumpCooldown
			and self:HasJumpableObstacle(
				Waypoint.Position
			)
		then
			LastJump =
				os.clock()

			self:ForceJump()

			Humanoid:MoveTo(
				Waypoint.Position
			)
		end

		--------------------------------------------------
		-- STUCK
		--------------------------------------------------

		if os.clock()
				- LastProgress
				>= self.Config.StuckCheckInterval
		then
			StuckJumps += 1

			--------------------------------------------------
			-- JUMP BEFORE GIVING UP
			--------------------------------------------------

			if Humanoid.FloorMaterial
				~= Enum.Material.Air
			then
				self:ForceJump()

				Humanoid:MoveTo(
					Waypoint.Position
				)
			end

			LastProgress =
				os.clock()

			PreviousPosition =
				Root.Position

			PreviousDistance =
				CurrentDistance

			--------------------------------------------------
			-- WE ARE ACTUALLY TRAPPED
			--------------------------------------------------

			if StuckJumps
				>= self.Config.MaxStuckJumps
			then
				return false,
					"Stuck"
			end
		end

		--------------------------------------------------
		-- TIMEOUT
		--------------------------------------------------

		if os.clock()
			- Started
			>= self.Config.WaypointTimeout
		then
			return false,
				"Stuck"
		end

		RunService.Heartbeat:Wait()
	end
end

--------------------------------------------------
-- FOLLOW PATH
--------------------------------------------------

function Navigator:FollowPath(
	Path,
	Generation,
	Options
)
	local Waypoints =
		Path:GetWaypoints()

	if #Waypoints == 0 then
		return false,
			"Repath"
	end

	Waypoints =
		self:SmoothWaypoints(
			Waypoints
		)

	local CurrentWaypoint = 1

	local Blocked =
		false

	local Connection =
		Path.Blocked:Connect(
			function(
				BlockedWaypoint
			)
				if BlockedWaypoint
					>= CurrentWaypoint
				then
					Blocked =
						true
				end
			end
		)

	for Index, Waypoint in ipairs(
		Waypoints
	) do
		CurrentWaypoint =
			Index

		if Blocked then
			Connection:Disconnect()

			return false,
				"Repath"
		end

		local Reached,
			Reason =
			self:FollowWaypoint(
				Waypoint,

				Generation,

				Options,

				Index
					== #Waypoints
			)

		if not Reached then
			Connection:Disconnect()

			return false,
				Reason
		end
	end

	Connection:Disconnect()

	return true,
		"Reached"
end

--------------------------------------------------
-- MOVE TO
--------------------------------------------------

function Navigator:MoveTo(
	Target,
	Options
)
	Options =
		Options or {}

	local Humanoid =
		self:GetHumanoid()

	local Root =
		self:GetRoot()

	if not Humanoid
		or not Root
	then
		return false,
			"NoCharacter"
	end

	local TargetPosition =
		self:GetTargetPosition(
			Target,
			Options
		)

	if not TargetPosition then
		return false,
			"InvalidTarget"
	end

	self:GetAgentSettings()

	self:Cancel()

	local Generation =
		self._moveGeneration

	for Attempt = 1,
		self.Config.MaxRepaths
	do
		local Abort =
			self:CheckAbort(
				Generation,
				Options
			)

		if Abort then
			return false,
				Abort
		end

		Root =
			self:GetRoot()

		if not Root then
			return false,
				"NoCharacter"
		end

		local Difference =
			TargetPosition
			- Root.Position

		local Horizontal =
			Vector3.new(
				Difference.X,
				0,
				Difference.Z
			).Magnitude

		local Vertical =
			math.abs(
				Difference.Y
			)

		if Horizontal
				<= self.Config.FinalReachDistance
			and Vertical
				<= self.Config.MaxFinalVerticalDifference
		then
			return true,
				"Reached"
		end

		--------------------------------------------------
		-- COMPUTE FRESH PATH
		--------------------------------------------------

		local Path =
			self:CreatePath(
				Root.Position,
				TargetPosition
			)

		if Path then
			local Reached,
				Reason =
				self:FollowPath(
					Path,
					Generation,
					Options
				)

			if Reached then
				return true,
					"Reached"
			end

			if Reason
				~= "Stuck"
				and Reason
					~= "Blocked"
				and Reason
					~= "Repath"
			then
				return false,
					Reason
			end
		end

		--------------------------------------------------
		-- PATH FAILED OR WE GOT STUCK
		--
		-- JUMP / MOVE OUT OF LOCAL CLUTTER
		--------------------------------------------------

		local Escaped,
			EscapeReason =
			self:TryLocalEscape(
				TargetPosition,
				Generation,
				Options
			)

		if not Escaped
			and EscapeReason
				~= "StillStuck"
		then
			return false,
				EscapeReason
		end

		task.wait(
			0.06
		)
	end

	return false,
		"Blocked"
end

--------------------------------------------------
-- CHARACTER RESET
--------------------------------------------------

LocalPlayer.CharacterAdded:Connect(
	function(
		Character
	)
		Navigator._character =
			Character

		Navigator._agentSettings =
			nil

		task.wait(
			0.5
		)

		Navigator:CalculateAgent()
	end
)

--------------------------------------------------
-- DESTROY
--------------------------------------------------

function Navigator:Destroy()
	self:Cancel()

	self._agentSettings =
		nil

	self._character =
		nil

	print(
		("[FleeTheFacility] %s %s destroyed"):format(
			self.Name,
			self.Version
		)
	)
end

return Navigator
